#!/usr/bin/env bash
# The claude-paint gate: one test-profile build of the workspace, then the
# retained checks (notes/speed/SKIPPED.md), at most four at a time. A check
# passes only if it exits 0 and prints what proves its tests ran: every named
# Rust test's ok line, or a count of at least one. The registered rag
# baseline mismatch (exit 4 with KNOWN_FAILURE: rag-historical-baseline-main)
# is reported as known. Exit 0 if nothing else failed, 1 otherwise.
#
#   scripts/test          (CARGO_TARGET_DIR is honored; a failed run keeps its logs)
set -uo pipefail
[ $# -eq 0 ] || { echo "usage: scripts/test" >&2; exit 2; }
repo=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo" || exit 1
# no __pycache__ in the checkout: one breaks the baseline package's file list
export PYTHONDONTWRITEBYTECODE=1
# the checks pick their boxes themselves
unset EASEL_BOX
work=$(mktemp -d "${TMPDIR:-/tmp}/gate.XXXXXX")
declare -A name_of=()
stop() {
  trap - INT TERM
  for p in "${!name_of[@]}"; do pkill -TERM -s "$p"; done
  wait
  rm -rf "$work"
  exit 130
}
trap stop INT TERM

# launch NAME COMMAND: runs COMMAND in its own session (perl: macOS has no setsid), output in $work/NAME.log
launch() {
  mkdir -p "$work/$1.tmp"
  echo "$EPOCHREALTIME" >"$work/$1.t0"
  TMPDIR=$work/$1.tmp perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' bash -c "$2" >"$work/$1.log" 2>&1 </dev/null &
  name_of[$!]=$1
}

# reap: waits for one launched command, stops what it left running (a crashed test's easel
# server) and records its exit and wall time
reap() {
  local pid rc name
  wait -n -p pid
  rc=$?
  name=${name_of[$pid]}
  unset "name_of[$pid]"
  pkill -KILL -s "$pid"
  echo "$rc" >"$work/$name.rc"
  awk -v a="$(cat "$work/$name.t0")" -v b="$EPOCHREALTIME" 'BEGIN { printf "%.1f", b - a }' >"$work/$name.secs"
}

t0=$EPOCHREALTIME
launch build "cargo test --workspace --no-run --config profile.test.debug=0 --lib --bin easel --test smoke --test look --test session_integrity --test live_frames --test live_replay_checkpoint --test replay_frames_resume --test painter_signals --test studio_profiles --test checkpoint_paths --test save_confined --test ck7 --test thinner_physics --test thinner_pigments --message-format=json-render-diagnostics >$(printf %q "$work/build.json")"
reap
if [ "$(cat "$work/build.rc")" != 0 ]; then
  cat "$work/build.log"
  echo "gate: the build FAILED"
  exit 1
fi
echo "gate: built in $(cat "$work/build.secs") s"
if ! uv run --no-project python scripts/cargo_test_executables.py "$work/build.json" >"$work/exes"; then
  echo "gate: the build artifact stream FAILED (logs: $work)"
  exit 1
fi
exe() { awk -F'\t' -v k="$1" '$1 == k { print $2 }' "$work/exes"; }
easel=$(exe 'bin easel')
[ -x "$easel" ] || { echo "gate: the build made no easel executable"; exit 1; }
easel=$(printf %q "$easel")

names=() cmds=() wants=()
# check NAME COMMAND WANT: WANT is newline-separated regexes, each of which must match a line of the output
check() { names+=("$1"); cmds+=("$2"); wants+=("$3"); }
# rust NAME CRATE TARGET [TEST...]: a test executable, run from its crate as cargo does; each named
# test (ignored ones too) must print ok, or with no names the executable must pass at least one test
rust() {
  local name=$1 crate=$2 bin want='^test result: ok\. [1-9]' t
  bin=$(exe "$3")
  [ -z "$bin" ] || bin=$(printf %q "$bin")
  shift 3
  if [ $# -gt 0 ]; then
    want=
    for t in "$@"; do want+="^test $t \\.\\.\\. ok\$"$'\n'; done
  fi
  check "$name" "cd crates/$crate && ${bin:-missing-test-executable} $* ${*:+--exact --include-ignored}" "$want"
}
# shellcheck disable=SC2016 # expanded by the check's own shell
pytest='mkdir -p "$TMPDIR/home" && uv run --no-project --with pytest --with pillow env HOME="$TMPDIR/home" python -m pytest -q -p no:cacheprovider --basetemp "$TMPDIR/pytest"'
passed='[1-9][0-9]* passed'
unittest=$'^Ran [1-9]\n^OK'

# longest first
check pastel-engine "cd crates/paint && $(printf %q "$(exe 'lib paint test')") --include-ignored pastel::tests:: sheet::tests:: graphite::tests:: checkpoint::tests::paper_and_stick_pastel_survive_a_checkpoint checkpoint::tests::a_laid_sheet_survives_a_checkpoint checkpoint::tests::drained_masking_sheets_keep_each_support" '^test result: ok\. [1-9]'
check pastel-session "cd crates/easel && $(printf %q "$(exe 'bin easel test')") api::draw_pencil::tests:: tests::a_held_stick tests::reference_looks_do_not_bypass_stick_pose_gating" '^test result: ok\. [1-9]'
rust smoke easel 'test smoke test'
rust look easel 'test look test'
rust session-integrity easel 'test session_integrity test'
rust live-frames easel 'test live_frames test'
rust live-replay-checkpoint easel 'test live_replay_checkpoint test'
rust replay-frames-resume easel 'test replay_frames_resume test'
rust replay-checkpoints easel 'bin easel test' \
  replay_checkpoint::tests::checkpoint_round_trip_reconstructs_closures_aliases_tools_rng_and_clock \
  replay_checkpoint::tests::pastel_checkpoints_reconstruct_stick_wear_and_dry_tools \
  replay_checkpoint::tests::corrupt_and_mismatched_checkpoints_are_refused \
  replay_checkpoint::tests::batch_identity_is_only_built_for_checkpoints_or_frames \
  replay_checkpoint::tests::checkpoint_resume_rejects_changed_build_width_and_environment \
  replay_checkpoint::tests::progress_is_published_at_every_chunk_and_batch_boundary \
  replay_checkpoint::tests::trace_failure_cannot_be_hidden_by_lua_pcall \
  replay_checkpoint::tests::exclusive_temporary_collisions_never_delete_existing_files \
  replay_checkpoint::tests::unrelated_non_utf8_environment_is_ignored \
  replay_checkpoint::tests::live_checkpoint_cadence_and_failed_writes_preserve_last_success \
  replay_checkpoint::tests::live_resume_accepts_appended_chunks_and_keeps_recording \
  replay_checkpoint::tests::live_checkpoint_reconstructs_temporary_tools_across_gc_schedules \
  replay_checkpoint::tests::live_resume_rejects_missing_and_changed_prefix_before_reconstruction \
  replay_checkpoint::tests::live_checkpoint_uses_its_startup_identity \
  replay_checkpoint::tests::live_scope_restores_both_traces_on_unwind \
  replay_checkpoint::tests::trace_rollback_discards_failed_events_and_restores_failure
rust painter-signals easel 'test painter_signals test'
rust studio-profiles easel 'test studio_profiles test'
check old-logs "scripts/tests/old_logs.sh $easel" '^old_logs: all [1-9][0-9]* cases replay as af49348 did$'
check studio-viewer "cd studio && $pytest -rs test_studio.py" "$passed"
check runner-round24 "cd notes/round24/runner && $pytest -rs ." "$passed"
rust paint-lib paint 'lib paint test' tests::fixture_matches_golden tests::drag_conserves_paint \
  tests::a_stroke_reaches_its_end tests::dry_is_idempotent_and_clears_wet tests::fixture_is_deterministic_across_thread_counts \
  tests::ground_drain_conserves_integrated_scattering tests::drained_deposition_keeps_its_pigment_when_wet_and_baked \
  thinner::tests::drained_flow_conserves_integrated_scattering rag::tests::a_drained_rag_smear_conserves_integrated_scattering \
  bristle::kernel_traps::ploughing_films_at_the_threshold_leaves_the_recorded_cure \
  thinner::tests::the_sparse_flow_set_moves_only_the_liquid_above_packed_paint \
  thinner::tests::paint_the_flow_brings_onto_absorbent_ground_drains_there \
  canvas::tests::a_liquid_film_levels_the_weave_under_it_from_engine_4 \
  surface::liquid_film_tests::absent_switch_keeps_the_old_surface_and_lighting_through_checkpoints \
  surface::box_blur_tests::row_major_columns_preserve_reference_bits \
  prepared_optics::tests::row_normals_match_original_bits_at_borders_and_extreme_slopes \
  prepared_optics::tests::row_preparation_preserves_material_lighting_within_tolerance_in_whole_and_cropped_frames \
  tests::image_tolerance::tests::two_levels_pass_in_every_channel_and_three_fail \
  tests::image_tolerance::tests::numeric_fields_accept_rounding_and_reject_regressions_and_nonfinite_values \
  drying::tests::checkpoint_mid_drying_resumes_exactly noise::tests::worley_finds_the_true_nearest_features \
  drying::tests::a_scraped_nan_film_can_wait_without_a_thickness_buffer \
  bristle::knife_skim::a_skimming_knife_keeps_its_light_on_wet_dark_paint \
  handling::wet_edges::a_blend_feathers_a_wet_edge_onto_dry_paint_and_stops \
  handling::wet_edges::a_thin_stroke_on_wet_paint_keeps_its_value_under_a_gentle_blend \
  handling::wet_edges::a_blend_still_works_a_thin_wet_film_on_dry_paint \
  rag::rag_lift::a_wipe_lifts_a_wet_passage_and_lays_none_of_it_further_along rag::rag_lift::a_mask_wipe_lifts_nothing_outside_its_mask \
  paper::tests::fiber_bounds_reject_only_empty_cropped_bands
rust easel-bin easel 'bin easel test' session::tests::engine_2_logs_replay_as_before \
  check::tests::visible_color_accepts_two_srgb_levels_at_every_pixel \
  check::tests::visible_color_rejects_three_srgb_levels_in_any_channel \
  check::tests::surface_uses_absolute_and_relative_tolerance \
  check::tests::nonfinite_color_and_surface_never_match \
  check::tests::color_and_surface_counts_must_match \
  live_frames::tests::atomic_frame_publication_keeps_the_previous_file_on_failure \
  live_frames::tests::index_write_failure_keeps_metadata_for_the_next_frame_and_upserts_once \
  live_frames::tests::portrait_frames_fit_the_long_side_and_existing_frames_are_untouched \
  session::tests::a_subnormal_blend_stays_finite_through_a_scrape_and_wait \
  look::tests::crops_of_any_span_are_bounded_and_report_the_actual_scale \
  look::tests::fitting_crops_keep_their_pixels_and_whole_views_keep_their_size \
  look::tests::masks_overlay_fill_and_outlines_in_crop_and_mirror_coordinates \
  session::tests::new_paintings_record_the_glaze_film_and_older_logs_replay_without_it \
  session::tests::a_glaze_tints_the_drawing_under_it_and_keeps_it_legible session::tests::a_scumble_at_half_coverage_leaves_gaps \
  session::tests::new_paintings_record_the_rag_lift_and_older_logs_replay_without_it \
  api::draw_rag::tests::a_wipe_on_a_full_face_says_so \
  session::tests::a_gesture_keeps_its_width_to_its_last_point \
  session::tests::new_paintings_record_the_knife_skim_and_older_logs_replay_without_it \
  session::tests::new_paintings_record_the_blend_feather_and_brush_skim_and_older_logs_replay_without_them \
  api::tests::math_random_keeps_old_draws_and_refuses_empty_ranges api::draw_rag::tests::an_older_log_sees_the_globals_it_saw \
  api::carried_palette_tests::a_dip_brings_the_arriving_brushs_paint_not_another_brushs_history \
  api::carried_palette_tests::graded_dips_preserve_palette_tint_strength_at_negligible_dirt \
  api::carried_palette_tests::every_internal_dip_carries_the_paint_retained_from_the_canvas \
  api::blend_at_masks_tests::soften_keeps_a_graded_mask_graded \
  api::blend_at_masks_tests::an_unclipped_blend_or_glaze_reaches_half_a_brush_past_its_mask
check thinner-check2 "scripts/thinner_check2 $easel" '^check 2: PASS$'
check easel-mcp 'uv run --no-project --script harness/easel_mcp/test_protocol.py ProtocolTests PreparationTests -v' "$unittest"
check painter-read 'node --experimental-strip-types --test --test-reporter=tap harness/painter/test/easel-client.test.ts' '^# pass [1-9][0-9]*$'
check painter-visit-lifecycle 'node --test --test-reporter=tap harness/painter/test/visit-lifecycle.test.ts' '^# pass [1-9][0-9]*$'
check easel-mcp-remote 'uv run --no-project --script harness/easel_mcp/test_remote.py -v' "$unittest"
check easel-mcp-critic 'uv run --no-project --script harness/easel_mcp/test_critic.py CriticTests -v' "$unittest"
check agy-critic-prepare 'uv run --no-project --script harness/easel_mcp/test_critic_prepare.py -v' "$unittest"
check die-roll 'uv run --no-project python -m unittest discover -s harness/painter/test -p test_die_roll.py -v' "$unittest"
check friedrich-models 'uv run --no-project python harness/painter/test/friedrich_models_test.py -v' "$unittest"
check atelier "cd atelier && $pytest -rs ." "$passed"
check painter-inbox 'uv run --no-project python harness/painter/test/inbox_test.py -v' "$unittest"
check painter-inbox-hooks 'node --test --test-reporter=tap harness/painter/test/inbox-hooks.test.ts' '^# pass [1-9]'
check painter-limit-abort 'node --test --test-reporter=tap harness/painter/test/limit-abort.test.ts' '^# pass [1-9]'
check painter-concepts 'node --test --test-name-pattern="file size limit" --test-reporter=tap harness/painter/test/concepts.test.ts' '^# pass [1-9]'
check reference-library 'uv run --no-project --script scripts/tests/reference_library.py -v' "$unittest"
check public-doc-compatibility 'uv run --no-project python -m unittest scripts/tests/launchd_install_test.py scripts/tests/export_materials_test.py scripts/tests/studio_guide_test.py scripts/tests/house_cleanup_test.py -v' "$unittest"
check box-notes 'uv run --no-project python -m unittest scripts/tests/box_notes_test.py -v' "$unittest"
check replay-batch 'uv run --no-project python -m unittest scripts/tests/replay_batch_test.py -v' "$unittest"
check cargo-test-executables 'uv run --no-project python -m unittest scripts/tests/cargo_test_executables_test.py -v' "$unittest"
check replay-clip 'uv run --no-project python -m unittest scripts/tests/replay_clip_test.py -v' "$unittest"
check export-painting 'uv run --script scripts/tests/export_painting_test.py -v' "$unittest"
check replay-pace 'uv run --script scripts/tests/replay_pace_test.py -v' "$unittest"
check reference-tools 'uv run --no-project --script harness/easel_mcp/test_references.py -v' "$unittest"
check baseline-guards "$pytest scripts/tests/baseline_state_compare_test.py scripts/tests/known_rag_baseline_test.py scripts/tests/check_painting_test.py" "$passed"
rust checkpoint-paths easel 'test checkpoint_paths test'
rust save-confined easel 'test save_confined test'
rust ck7 easel 'test ck7 test'
rust thinner-physics paint 'test thinner_physics test' c04_a_stroke_and_a_wipe_account_for_all_paint_and_solvent \
  c09_the_solvent_evaporates_and_the_film_loses_its_volume
rust thinner-pigments paint 'test thinner_pigments test' c13_every_pigment_value_is_af49348s
check image-tolerance 'uv run --script scripts/tests/image_tolerance.py' '^image_tolerance: [1-9][0-9]* cases passed$'
check baseline-package notes/thinner/baseline/tools/verify_package.sh '^verify_package: hashes ok'

for i in "${!names[@]}"; do
  [ "${#name_of[@]}" -lt 4 ] || reap
  launch "${names[$i]}" "${cmds[$i]}"
done
while [ "${#name_of[@]}" -gt 0 ]; do reap; done

failed=() known=()
for i in "${!names[@]}"; do
  name=${names[$i]} log=$work/${names[$i]}.log rc=$(cat "$work/${names[$i]}.rc") missing=
  if [ "$rc" = 4 ] && grep -qx 'KNOWN_FAILURE: rag-historical-baseline-main' "$log"; then
    known+=("$name")
    echo "gate: $name: known failure, the registered rag baseline mismatch ($(cat "$work/$name.secs") s)"
    continue
  fi
  while IFS= read -r want; do
    [ -z "$want" ] || grep -qE -- "$want" "$log" || missing+="; no line matching $want"
  done <<<"${wants[$i]}"
  if [ "$rc" = 0 ] && [ -z "$missing" ]; then
    echo "gate: $name: ok ($(cat "$work/$name.secs") s)"
    continue
  fi
  failed+=("$name")
  echo "gate: $name: FAILED (exit $rc$missing)"
  sed 's/^/  | /' "$log"
done
secs=$(awk -v a="$t0" -v b="$EPOCHREALTIME" 'BEGIN { printf "%.0f", b - a }')
if [ ${#failed[@]} -gt 0 ]; then
  echo "gate: FAILED in $secs s: ${failed[*]} (logs: $work)"
  exit 1
fi
rm -rf "$work"
echo "gate: passed in $secs s, ${#names[@]} checks${known[0]:+; known failure only: ${known[*]}}"
