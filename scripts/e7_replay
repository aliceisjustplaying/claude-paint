#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""Time an `easel run` replay of a Lua log through engine 5 or engine 7.

    scripts/e7_replay run LOG --engine 7 --workers 4 [--chunks 12] [--width PX] [--easel PATH] [--out DIR]
    scripts/e7_replay table DIR/*.json

run replays LOG with RAYON_NUM_THREADS=--workers. The finishing chunk is
always dropped (a replay ends on plain paint); --chunks K keeps only the
first K chunks. Under --out it writes:

    <name>.lua        the replayed program
    <name>.png        the replay's gallery-lit image (easel run --gallery)
    <name>.stderr     easel's stderr, verbatim
    <name>.json       wall, CPU, CPU/wall, peak RSS, per-chunk seconds and,
                      when easel prints E7BATCH lines (E7_STATS=1 is set),
                      each batch's ready width

<name> is <log stem>-e<engine>-w<workers>[-p<chunks>]. The JSON record is
the engine7-bench-v1 schema (handoffs/engine-next/CONTRACTS.md); unmeasured
metrics are null. CPU and peak RSS are the child's rusage, so they hold on
Linux and macOS alike. Engine 7 is asked for the way the contract says: the
scratch copy's "--@ engine 5" head line becomes "--@ engine 7".

table folds .json results into one Markdown table.
"""

import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import resource
import subprocess
import sys
import time

MARK = "--@ chunk"
FINISHING = "--@ chunk (finishing)"
CHUNK = re.compile(r"^\s*chunk\s+(\d+)\s+([0-9.]+)s\s*$")
PAINTED = re.compile(r"painted in ([0-9.]+)s, total ([0-9.]+)s")
BATCH = re.compile(r"^E7BATCH\t(.*)$")
BATCH_FIELDS = ["chunk", "batch", "tiles", "peak_ready", "peak_inflight", "wall_s", "sum_tile_s"]
ENGINE_LINE = re.compile(r"^--@ engine (\d+)\s*$", re.M)
SIZE = re.compile(r"canvas\s*\{[^}]*?size\s*=\s*([0-9.]+)")


def program(text, chunks):
    """The log without its finishing chunk, cut to its first chunks chunks."""
    out, seen = [], 0
    for line in text.splitlines(keepends=True):
        mark = line.strip()
        if mark.startswith(FINISHING):
            break
        if mark.startswith(MARK):
            seen += 1
            if chunks is not None and seen > chunks:
                break
        out.append(line)
    if seen == 0:
        raise SystemExit("no chunks in the log")
    if chunks is not None and seen < chunks:
        raise SystemExit(f"the log has {seen} chunks, fewer than --chunks {chunks}")
    return "".join(out), min(seen, chunks or seen)


def batches(lines):
    rows = []
    for line in lines:
        m = BATCH.match(line)
        if m:
            rows.append({k: float(v) for k, v in zip(BATCH_FIELDS, m.group(1).split("\t"))})
    return rows


def ready_width(rows):
    """Peak ready width, and the tile-time-weighted mean of each batch's peak."""
    work = sum(r["sum_tile_s"] for r in rows)
    if not rows or work <= 0:
        return None
    return {
        "max": max(r["peak_ready"] for r in rows),
        "mean": round(sum(r["peak_ready"] * r["sum_tile_s"] for r in rows) / work, 3),
        "method": "E7BATCH peak_ready, weighted by summed tile seconds",
    }


def with_engine(text, engine):
    """The program with its head naming engine (only 5 -> 7 is a change)."""
    head = text.split(MARK, 1)[0]
    m = ENGINE_LINE.search(head)
    logged = int(m.group(1)) if m else 1
    if engine == logged:
        return text
    if (logged, engine) != (5, 7):
        raise SystemExit(f"the log is engine {logged}; only an engine 5 log replays through engine 7")
    return text[: m.start()] + "--@ engine 7" + text[m.end():]


def run(args):
    log = Path(args.log).resolve()
    raw = log.read_text()
    text, n = program(raw, args.chunks)
    text = with_engine(text, args.engine)
    size = SIZE.search(text)
    revision = subprocess.run(["git", "rev-parse", "HEAD"], cwd=Path(__file__).resolve().parent, capture_output=True, text=True).stdout.strip() or None
    name = f"{log.stem}-e{args.engine}-w{args.workers}" + (f"-p{args.chunks}" if args.chunks else "")
    out = Path(args.out).resolve()
    out.mkdir(parents=True, exist_ok=True)
    src = out / f"{name}.lua"
    src.write_text(text)
    png, err = out / f"{name}.png", out / f"{name}.stderr"
    cmd = [args.easel, "run", str(src), "--out", str(png), "--gallery"]
    if args.width:
        cmd += ["--width", str(args.width)]
    env = dict(os.environ, RAYON_NUM_THREADS=str(args.workers), E7_STATS="1")
    before = resource.getrusage(resource.RUSAGE_CHILDREN)
    t0 = time.monotonic()
    with open(err, "w") as e:
        p = subprocess.run(cmd, env=env, stdout=subprocess.DEVNULL, stderr=e)
    wall = time.monotonic() - t0
    after = resource.getrusage(resource.RUSAGE_CHILDREN)
    lines = err.read_text().splitlines()
    if p.returncode != 0:
        sys.stderr.write("\n".join(lines[-20:]) + "\n")
        raise SystemExit(f"easel exited {p.returncode}: {' '.join(cmd)}")
    per_chunk = [float(m.group(2)) for m in map(CHUNK.match, lines) if m]
    painted = next((m for m in map(PAINTED.search, lines) if m), None)
    cpu = (after.ru_utime - before.ru_utime) + (after.ru_stime - before.ru_stime)
    # ru_maxrss is KiB on Linux, bytes on macOS
    rss = after.ru_maxrss * (1 if platform.system() == "Darwin" else 1024)
    rows = batches(lines)
    result = {
        "schema": "engine7-bench-v1",
        "painting": log.name,
        "input_sha256": hashlib.sha256(raw.encode()).hexdigest(),
        "chunk_count": n,
        "revision": revision,
        "engine": args.engine,
        "width_px": args.width or 2400,
        "physical_width_mm": float(size.group(1)) if size else None,
        "workers": args.workers,
        "backend": args.backend,
        "wall_s": round(wall, 3),
        "paint_s": float(painted.group(1)) if painted else None,
        "cpu_s": round(cpu, 3),
        "cpu_over_wall": round(cpu / wall, 3),
        "peak_rss_bytes": rss,
        "ready_width": ready_width(rows),
        "chunks": [{"index": i + 1, "wall_s": t} for i, t in enumerate(per_chunk)],
        "batches": rows,
        "host": platform.node(),
        "machine": platform.machine(),
        "cpus": os.cpu_count(),
        "easel": args.easel,
        "render": {"png": str(png), "look": "gallery", "light": "easel run --gallery"},
    }
    (out / f"{name}.json").write_text(json.dumps(result, indent=1) + "\n")
    print(f"{name}: wall {wall:.1f}s, paint {result['paint_s']}s, CPU/wall {result['cpu_over_wall']}, peak RSS {rss / 2**20:.0f} MiB, {len(per_chunk)} chunks, ready width {result['ready_width']}")


def table(args):
    rows = [json.loads(Path(p).read_text()) for p in args.results]
    rows.sort(key=lambda r: (r["painting"], r["chunk_count"], r["workers"], r["engine"]))
    print("| Painting | Chunks | Workers | Engine | Wall s | CPU/wall | Peak RSS MiB | Ready width (max / mean) | Host |")
    print("| --- | ---: | ---: | ---: | ---: | ---: | ---: | --- | --- |")
    for r in rows:
        w = r.get("ready_width")
        width = f"{w['max']:.0f} / {w['mean']:.2f}" if w else "n/a"
        print(f"| {r['painting']} | {r['chunk_count']} | {r['workers']} | {r['engine']} | {r['wall_s']:.1f} | {r['cpu_over_wall']:.2f} | {r['peak_rss_bytes'] / 2**20:.0f} | {width} | {r['host']} ({r['cpus']} CPU) |")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("log")
    r.add_argument("--engine", type=int, choices=[5, 7], required=True)
    r.add_argument("--workers", type=int, required=True)
    r.add_argument("--chunks", type=int)
    r.add_argument("--width", type=int, help="replay width in px (default: the width the log was painted at)")
    r.add_argument("--easel", default=os.environ.get("EASEL", "easel"))
    r.add_argument("--backend", default="scalar", help="recorded only: scalar, avx2 or neon")
    r.add_argument("--out", default="e7-replays")
    t = sub.add_parser("table")
    t.add_argument("results", nargs="+")
    args = ap.parse_args()
    run(args) if args.cmd == "run" else table(args)


if __name__ == "__main__":
    main()
