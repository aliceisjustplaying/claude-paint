#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["mcp==1.30.0", "uvicorn==0.42.0", "pillow>=10"]
# ///

import argparse
import asyncio
import base64
import http.server
import importlib.util
import json
import os
from pathlib import Path
import secrets
import socket
import subprocess
import sys
import threading

import httpx
from mcp import ClientSession
from mcp.client.streamable_http import streamable_http_client
import uvicorn

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "harness/easel_mcp"))
from http_server import app_for
from remote import RemoteStudio


async def main():
    parser = argparse.ArgumentParser(description="Local HTTP → real easel → studio viewer proof, with no public tunnel.")
    parser.add_argument("--studio", type=Path, required=True, help="a newly exported, empty paint-studio-<hex> folder")
    parser.add_argument("--sessions-root", type=Path, required=True)
    parser.add_argument("--out", type=Path, required=True)
    parser.add_argument("--viewer-url", help="existing loopback viewer; omit to start an isolated viewer")
    args = parser.parse_args()
    studio = args.studio.expanduser().resolve(strict=True)
    log = studio / "paintings/lua/painting.lua"
    if log.exists() and log.stat().st_size:
        parser.error("the proof refuses a studio that already has a painting log")
    if args.viewer_url and not args.viewer_url.startswith(("http://127.0.0.1:", "http://localhost:")):
        parser.error("viewer-url must be a loopback URL")
    out = args.out.expanduser().resolve()
    out.mkdir(parents=True, exist_ok=True)
    os.environ["RAYON_NUM_THREADS"] = "2"
    owner = RemoteStudio(studio, args.sessions_root, response_wait=1)
    listener = socket.socket()
    listener.bind(("127.0.0.1", 0))
    url = f"http://127.0.0.1:{listener.getsockname()[1]}/mcp"
    token = secrets.token_urlsafe(32)
    server = uvicorn.Server(uvicorn.Config(app_for(owner, token), log_level="error", access_log=False))
    serving = asyncio.create_task(server.serve(sockets=[listener]))
    viewer = None
    if args.viewer_url:
        viewer_url = args.viewer_url.rstrip("/")
    else:
        sys.path.insert(0, str(REPO / "studio"))
        spec = importlib.util.spec_from_file_location("proof_viewer", REPO / "studio/studio.py")
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        module.SESSIONS = str(args.sessions_root.expanduser().resolve())
        viewer = http.server.ThreadingHTTPServer(("127.0.0.1", 0), module.H)
        threading.Thread(target=viewer.serve_forever, daemon=True).start()
        viewer_url = f"http://127.0.0.1:{viewer.server_port}"
    try:
        for _ in range(200):
            if server.started:
                break
            await asyncio.sleep(0.01)
        if not server.started:
            raise RuntimeError("the local HTTP MCP server did not start")
        async with httpx.AsyncClient(headers={"Authorization": "Bearer " + token}, timeout=30) as http_client:
            async with streamable_http_client(url, http_client=http_client) as (read, write, _):
                async with ClientSession(read, write) as client:
                    await client.initialize()

                    async def call(name, parameters):
                        for _ in range(120):
                            result = await client.call_tool(name, parameters)
                            if result.isError:
                                raise RuntimeError(result.content[0].text)
                            if not result.content[0].text.startswith(f"Call {parameters['call_id']} is still running."):
                                return result
                        raise RuntimeError("the proof call did not finish")

                    canvas = 'local t=tubes(); canvas{size=100,aspect=1.25,linen=15,ground={{pile={{t[1],1}},um=80,apply="knife"}}}'
                    mark = 'local t=tubes(); b=brush("round",4); b:load(pile{{t[#t],1}},0.8); b:stroke({{200,300},{800,320}})'
                    for index, lua in enumerate((canvas, mark), 1):
                        await call("paint", {"lua": lua, "call_id": f"proof-paint-{index}"})
                    before = log.read_bytes()
                    await call("paint", {"lua": mark, "call_id": "proof-paint-2"})
                    assert log.read_bytes() == before, "a retried call changed the painting log"
                    await call("note", {"text": "HTTP proof completed.", "call_id": "proof-note"})
                    look = await call("look", {"size": 320, "call_id": "proof-look"})
                    image = base64.b64decode(look.content[1].data)
                    (out / "look.png").write_bytes(image)
        async with httpx.AsyncClient() as http_client:
            response = await http_client.get(viewer_url + "/api/events", params={"p": studio.name})
            response.raise_for_status()
            events = response.json()["events"]
            assert sum(event["kind"] == "paint" for event in events) == 2
            viewed = next(event for event in events if event["kind"] == "image")
            response = await http_client.get(viewer_url + "/img", params={"p": studio.name, "i": viewed["img"]})
            response.raise_for_status()
            assert response.content == image, "the viewer served different bytes from the MCP look"
            (out / "viewer.png").write_bytes(response.content)
        receipt = {"studio": studio.name, "paint_calls": 2, "retry_added_chunks": 0, "viewer_image_matches_mcp": True, "viewer_url": viewer_url, "public_tunnel": False}
        (out / "receipt.json").write_text(json.dumps(receipt, indent=2) + "\n")
        print(json.dumps(receipt, indent=2))
    finally:
        server.should_exit = True
        await serving
        if viewer:
            await asyncio.to_thread(viewer.shutdown)
            viewer.server_close()
        await asyncio.to_thread(subprocess.run, [str(studio / "bin/easel"), "close"], cwd=studio, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)


if __name__ == "__main__":
    asyncio.run(main())
