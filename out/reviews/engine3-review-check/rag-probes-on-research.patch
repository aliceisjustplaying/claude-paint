+pub fn step_mm(d: f32) -> f32 { STEP_O.with(|c| c.get()).unwrap_or(d) }
+pub fn reset_counters() {
+    MECH_STEPS.with(|c| c.set(0)); PRESS_CALLS.with(|c| c.set(0)); INVERTED.with(|c| c.set(0)); TRIS.with(|c| c.set(0));
+    MULTI.with(|c| c.set(0)); TOUCHED.with(|c| c.set(0)); UVJUMP.with(|c| c.set(0)); CHIST.with(|c| c.set([0; 12]));
