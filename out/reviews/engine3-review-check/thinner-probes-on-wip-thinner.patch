+/// The reviewer's new finding: the rag's stain floor against the thinned stroke's ceiling.
+#[test]
+#[ignore = "review probe"]
+fn review_rag_floor() {
+    use paint::rag::Rag;
+    println!("[J] wip/thinner as it stands; 2400-px-size pixels (110 mm, 600 px), flat ground; filbert 60, load .8; then a clean rag (150 units, dipped .5, p .8) wiped twice along the stroke");
+    println!("  thinner  passes | paint in the lane: mean um  median  max  px at or under 1 um | removed by 2 damp wipes | most a 1 um floor allows | paint lifted mm3");
+    for (t, passes) in [(0.0f32, 1usize), (0.5, 1), (2.0 / 3.0, 1), (0.75, 1), (0.9, 1), (0.5, 4), (0.75, 4), (0.9, 4)] {
+        let mut c = Canvas::new(600, 1.0, hex("#d8cdb8")).with_engine(3).with_size_mm(110.0);
+        c.prime(hex("#b9a98c"), 0.9, 60.0, 0.6, 0.0, 7);
+        for k in 0..passes {
+            let p = if t > 0.0 { raw_sienna().with_thinner(t) } else { raw_sienna() };
+            let mut h = brush(Tool::filbert(60.0), 71 + k as u64, p, 0.8);
+            stroke(&mut c, &mut h, vec![(150.0, 500.0), (850.0, 500.0)], 0.8);
+        }
+        let lane: Vec<(usize, f32, f32)> = in_rect(&c, (300.0, 470.0, 700.0, 530.0)).into_iter().filter(|&(_, x, y)| c.wet_um(x, y) > 0.01).collect();
+        let before: Vec<f32> = lane.iter().map(|&(_, x, y)| c.wet_um(x, y)).collect();
+        let mut sorted = before.clone();
+        sorted.sort_by(f32::total_cmp);
+        let under = before.iter().filter(|&&v| v <= 1.0).count();
+        let bound = before.iter().map(|&v| (v - 1.0).max(0.0) as f64).sum::<f64>() / sum(&before);
+        let mut rag = Rag::new(150.0, 7);
+        let now = c.now_min();
+        rag.dip(0.5, now, c.tally_mut());
+        let mut lifted = 0.0;
+        for _ in 0..2 { lifted += c.rag_wipe(&mut rag, &[(200.0, 500.0), (800.0, 500.0)], &[0.8], 19); }
+        let after: Vec<f32> = lane.iter().map(|&(_, x, y)| c.wet_um(x, y)).collect();
+        println!("  {t:7.3}  {passes:6} | {:26.3}  {:6.3}  {:5.2}  {:6} of {:6} | {:22.1}% | {:23.1}% | {lifted:.4}",
+            sum(&before) / before.len() as f64, sorted[sorted.len() / 2], sorted[sorted.len() - 1], under, before.len(), 100.0 * (1.0 - sum(&after) / sum(&before)), 100.0 * bound);
+    }
+}
