#!/usr/bin/env bash
# Check a painter's log after the painter's last sitting, with the replay
# build: what `easel check` did in the painter's hands before round 19. The
# painter build has no `check`; the runner runs this in the background and
# logs the result.
#
#   scripts/check_painting <studio> <workdir>
#
# <workdir> is a new (or empty) folder. The studio is only read: its log
# (paintings/lua/painting.lua) is copied into <workdir> as the log and the
# committed record, and a session of the replay build (EASEL_ROOT=<workdir>)
#   1. opens it, which replays the log (a chunk that fails to replay fails
#      here),
#   2. saves the replayed canvas (<workdir>/replayed.png) and compares it
#      exactly for the same build, or with the bounded cross-build image
#      tolerance (notes/workflow.md), with the live canvas saved when it
#      closed (<studio>/out/easel/painting/live.png; live.txt says how many
#      chunks it holds and how many of those the session had replayed from
#      the log rather than painted), and with the painter's last save
#      (<studio>/out/easel/painting/painting.png), if there is one,
#   3. closes, which writes the replay's save file (the canvas state and the
#      studio fields, crates/easel/src/save.rs), and compares it byte for byte
#      with the save the painter's session wrote at close
#      (<studio>/out/easel/painting/live.ckpt, or live.ckpt.zst / .gz once
#      scripts/finish_painting has compressed it). The replay's copy is
#      deleted after. Across builds the checkpoint difference is diagnostic
#      when the live PNG meets the image tolerance; same-build checks stay exact.
# It also says whether the studio's committed record
# (out/easel/painting/committed.lua) equals its log.
#
# Prints a report and, last, one line starting "check:": "check: ok" when
# the replay agrees with the live canvas or the live save and differs from
# neither; "check: replay only" when the log replays but there is neither of
# the whole log to compare with (none saved, saved at another chunk count, or
# by a session that had replayed every chunk); "check: DIFFERS" otherwise. Exit 0 for the first two, 1 for DIFFERS or a log that doesn't
# replay (2: usage). The comparison with the painter's save is reported, not
# judged: a painter may have painted after its last save.
set -euo pipefail
# the log names its box, and the replay takes it from there: a box set in
# the caller's environment (EASEL_BOX) would only make the easel refuse the log
unset EASEL_BOX

usage() { sed -n '7,7p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
[ $# -eq 2 ] || usage
studio=$(cd "$1" && pwd)
work=$2
log=$studio/paintings/lua/painting.lua
[ -s "$log" ] || { echo "check: no log at $log"; exit 1; }
if [ -e "$work" ] && [ -n "$(ls -A "$work" 2>/dev/null)" ]; then
  echo "$work exists and isn't empty" >&2
  exit 2
fi
mkdir -p "$work/paintings/lua" "$work/out/easel/painting" "$work/notes"
work=$(cd "$work" && pwd)

repo=$(cd "$(dirname "$0")/.." && pwd)
# the replay build, in the target directory cargo builds into (CARGO_TARGET_DIR too)
easel=$("$repo/scripts/replay_easel")

cp "$log" "$work/paintings/lua/painting.lua"
cp "$log" "$work/out/easel/painting/committed.lua"
chunks=$(grep -c '^--@ chunk' "$log" || true)
committed=$studio/out/easel/painting/committed.lua
if [ ! -f "$committed" ]; then
  record="no committed record in the studio"
elif cmp -s "$committed" "$log"; then
  record="the studio's committed record equals its log"
else
  record="the studio's committed record DIFFERS from its log"
fi
echo "log: $log ($chunks chunks); $record"

E() { EASEL_ROOT="$work" EASEL_SESSION=painting "$easel" "$@"; }
trap 'E close >/dev/null 2>&1 || true' EXIT
t0=$(date +%s)
if ! out=$(cd "$work" && E open painting 2>&1); then
  echo "$out"
  echo "check: FAILED: the log doesn't reopen ($(echo "$out" | tail -1))"
  exit 1
fi
echo "$out"
t1=$(date +%s)
(cd "$work" && E save "$work/replayed.png" >/dev/null)
E close >/dev/null
trap - EXIT
t2=$(date +%s)

live=$studio/out/easel/painting/live.png
livetxt=$studio/out/easel/painting/live.txt
livebuild=$(awk '$1 == "build" { print $2 }' "$livetxt" 2>/dev/null || true)
replaybuild=$(awk '$1 == "build" { print $2 }' "$work/out/easel/painting/live.txt")
samebuild=false
[ -n "$livebuild" ] && [ "$livebuild" = "$replaybuild" ] && samebuild=true
lk=none
lchunks=; lrep=
[ -f "$livetxt" ] && lchunks=$(awk '$1 == "chunks" { print $2 }' "$livetxt") && lrep=$(awk '$1 == "replayed" { print $2 }' "$livetxt")
if [ ! -f "$live" ] || [ ! -f "$livetxt" ]; then
  livecmp="the session saved no live canvas at close"
else
  if [ "$lchunks" != "$chunks" ]; then
    livecmp="the live canvas saved at close holds ${lchunks:-an unknown number of} chunks, the log $chunks"
  elif cmp -s "$live" "$work/replayed.png"; then
    livecmp="the replay equals the live canvas saved at close"
    lk=same
  elif [ "$samebuild" = false ] && uv run --script "$repo/scripts/compare_images.py" "$live" "$work/replayed.png"; then
    livecmp="the cross-build replay matches the live canvas within the image tolerance"
    lk=same
  else
    livecmp="the replay DIFFERS from the live canvas saved at close"
    lk=differs
  fi
  if [ "$lk" != none ] && [ "${lrep:-0}" -gt 0 ]; then
    livecmp="$livecmp (the session had replayed $lrep of its $lchunks chunks from the log)"
    if [ "$lk" = same ] && [ "$lrep" -ge "$lchunks" ]; then lk=none; fi
  fi
fi
echo "$livecmp"

# the save files: the session's at close against the replay's
ours=$work/out/easel/painting/live.ckpt
sk=none
theirs=
for f in "$studio/out/easel/painting/live.ckpt" "$studio/out/easel/painting/live.ckpt.zst" "$studio/out/easel/painting/live.ckpt.gz"; do
  [ -f "$f" ] && { theirs=$f; break; }
done
same_save() { # cmp exits 2 if the file went (compressed meanwhile): try the compressed copy
  case "$1" in
    *.zst) zstd -dc "$1" | cmp -s - "$ours" ;;
    *.gz) gzip -dc "$1" | cmp -s - "$ours" ;;
    *) cmp -s "$1" "$ours" ;;
  esac
}
if [ -z "$theirs" ]; then
  savecmp="the session wrote no save file at close"
elif [ ! -f "$ours" ]; then
  savecmp="the replay wrote no save file"
elif [ "${lchunks:-}" != "$chunks" ]; then
  savecmp="the save written at close holds ${lchunks:-an unknown number of} chunks, the log $chunks"
else
  rc=0; same_save "$theirs" || rc=$?
  if [ $rc = 2 ] && [ "$theirs" = "$studio/out/easel/painting/live.ckpt" ]; then
    for f in "$theirs.zst" "$theirs.gz"; do [ -f "$f" ] && { theirs=$f; rc=0; same_save "$f" || rc=$?; break; }; done
  fi
  if [ $rc = 0 ]; then
    savecmp="the replay's canvas state equals the save written at close"; sk=same
  else
    savecmp="the replay's canvas state DIFFERS from the save written at close"; sk=differs
  fi
  if [ "${lrep:-0}" -gt 0 ]; then
    savecmp="$savecmp (the session had replayed $lrep of its $lchunks chunks from the log)"
    if [ "$sk" = same ] && [ "$lrep" -ge "$lchunks" ]; then sk=none; fi
  fi
fi
rm -f "$ours"
echo "$savecmp"

saved=$studio/out/easel/painting/painting.png
if [ ! -f "$saved" ]; then
  png="the painter saved no picture"
elif cmp -s "$saved" "$work/replayed.png"; then
  png="the replay's PNG equals the painter's last save"
else
  if [ "$saved" -ot "$log" ]; then when="saved before the log's last change"; else when="saved after the log's last change"; fi
  png="the replay's PNG differs from the painter's last save ($when)"
fi
echo "$png"
echo "times: reopen $((t1 - t0)) s, save and close $((t2 - t1)) s"
if [ $lk = differs ]; then
  echo "check: DIFFERS from the live canvas: $livecmp; $savecmp; $png; $record"
  exit 1
elif [ $sk = differs ] && { [ "$samebuild" = true ] || [ "$lk" != same ]; }; then
  echo "check: DIFFERS from the live save: $savecmp; $livecmp; $png; $record"
  exit 1
elif [ $lk = same ] || [ $sk = same ]; then
  echo "check: ok: $chunks chunks replay to the live canvas; $livecmp; $savecmp; $png; $record"
else
  echo "check: replay only: $chunks chunks replay, but $livecmp; $savecmp; $png; $record"
fi
