#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# ///
import argparse
import ast
import json
from pathlib import Path
import runpy
import shutil
import subprocess


OPENING = (
    "Compose and paint one original picture in the manner of Caspar David\n"
    "Friedrich, at the easel, a simulator of oil paint on linen. His pictures\n"
    "are composed in large, simple masses, and over those masses they carry a\n"
    "great deal of particular detail, each small form drawn and painted on its\n"
    "own. The place, subject and composition are yours to invent. Work from\n"
    "knowledge and the notes in your studio; don't use reference images, image\n"
    "models or pictures of his work."
)
READING = (
    "notes/easel_guide.md; notes/techniques.md; notes/studio_notes.md;\n"
    "notes/research/friedrich_materials.md (his materials and method, sourced) and\n"
    "notes/research/oil_paint_physics.md as needed.\n\n"
    "After choosing a subject or technical question, use `reference` to search\n"
    "the studio's reference library, or `reference_list` to browse its titles.\n"
    "Read a result with `reference` by its id; follow next_page\n"
    "until it is null to read the full text."
)
TOOLS = "paint,look,probe,note,status,log,read,reference,reference_list"
DIE_ROLL_SECTION = (
    "## Choosing the picture\n"
    "Before you paint, write sixteen different pictures you could make from this brief in notes/concepts.md, numbered 1 to 16, each in a sentence or two. After each one, write your estimate of how many painters out of a hundred given this brief would make that picture. The studio sets aside the ten with the highest estimates, rolls a die among the other six and tells you which one is yours. You make every decision from there, and the picture can develop wherever the painting takes it.\n\n"
)
# --critic (harness/painter/visit.ts): a second painter visits as a critic
CRITIC_READING = (
    "\n\n"
    "Another painter visits your studio as a critic, at the end of each sitting\n"
    "and whenever you ask for a visit with `ask_critic`. The critic looks at the\n"
    "painting with the same `look` you use and reads your journal and the note\n"
    "you give `ask_critic` (kept in notes/to_critic.md); it doesn't paint. It\n"
    "writes whether it thinks the picture is finished and, if not, what matters\n"
    "most to the picture and why, in notes/critic.md, which you get at the start\n"
    "of your next sitting or as `ask_critic`'s reply. It doesn't see your code,\n"
    "masks or mixtures: weigh what it sees against the picture, and treat a\n"
    "method it suggests as one way to try, at the passage's real scale."
)


def corrected_runner(source, tools=TOOLS, reading=READING, die_roll=False):
    lines = source.splitlines(keepends=True)
    changes = []
    found = set()
    entrypoint = []
    for node in ast.walk(ast.parse(source)):
        if isinstance(node, ast.Assign) and len(node.targets) == 1:
            target = ast.unparse(node.targets[0])
            if target == "TOOLS":
                changes.append((node.lineno, node.end_lineno, f"TOOLS = {tools!r}\n"))
                found.add("tools")
            if target == "READING['friedrich']":
                changes.append((node.lineno, node.end_lineno, f"READING['friedrich'] = {reading!r}\n"))
                found.add("reading")
            if target == "OPENING" and isinstance(node.value, ast.Dict):
                for key, value in zip(node.value.keys, node.value.values):
                    if isinstance(key, ast.Constant) and key.value == "friedrich":
                        prefix = lines[value.lineno - 1].encode()[:value.col_offset].decode()
                        suffix = lines[value.end_lineno - 1].encode()[value.end_col_offset:].decode()
                        changes.append((value.lineno, value.end_lineno, prefix + repr(OPENING) + suffix))
                        found.add("opening")
        if isinstance(node, ast.If) and ast.unparse(node.test) == "t['profile'] == 'friedrich'":
            block = ast.get_source_segment(source, node)
            if "friedrich_painter.md" in block and "trees.md" in block:
                changes.append((node.lineno, node.end_lineno, ""))
                found.add("copy")
        if isinstance(node, ast.If) and ast.unparse(node.test) == "__name__ == '__main__'":
            entrypoint.append((node.lineno, node.end_lineno, "if __name__ == '__main__':\n    raise SystemExit('Use the prepared run.py entrypoint; this file supplies the house sitting loop.')\n"))
    if found != {"tools", "reading", "opening", "copy"} or len(changes) != 4:
        raise ValueError("house runner differs from the reviewed template; review its preparation before continuing")
    for start, end, replacement in sorted(changes + entrypoint, reverse=True):
        lines[start - 1:end] = [replacement]
    result = "".join(lines)
    if die_roll:
        tree = ast.parse(result)
        hooks = [node for node in ast.walk(tree) if isinstance(node, ast.Assign)
                 and any(isinstance(t, ast.Name) and t.id == "stem" for t in node.targets)
                 and 'p{n}_s{k}' in ast.get_source_segment(result, node)]
        if len(hooks) != 1:
            raise ValueError("house runner differs: expected one sitting opener")
        lines = result.splitlines(keepends=True)
        hook = hooks[0]
        indent = " " * hook.col_offset
        lines.insert(hook.lineno - 1, indent + 'if not cont and (k == 1 or before == 0):\n' + indent + '    msg = DIE_ROLL_OPENING + "\\n\\n" + msg\n')
        result = "".join(lines)
    if "friedrich_painter.md" in result or "notes/research/trees.md" in result:
        raise ValueError("house runner still supplies the retired required reading")
    ast.parse(result)
    return result


def prepare(studio, house, runner, studio_notes, run_dir=None, critic=False, die_roll=False, painter=None, critic_model=None):
    if critic_model is not None and not critic:
        raise ValueError("--critic-model requires --critic")
    if (studio / "bin/box").read_text().strip() != "friedrich":
        raise ValueError("expected an exported Friedrich studio")
    if (studio / "out").exists() or any((studio / "paintings/lua").iterdir()) or (studio / "notes/journal.md").read_text():
        raise ValueError("prepare a new empty studio, not an existing painting")
    if (studio / "BRIEF.md").exists() or runner.exists():
        raise ValueError("the brief or runner already exists")
    if any((studio / "notes/research" / name).exists() for name in ("friedrich_painter.md", "trees.md")):
        raise ValueError("the new studio already has retired required reading")
    if not (studio / "notes/reference-library.json").is_file():
        raise ValueError("export the reference library before preparing the brief")
    tools, reading = (TOOLS + ",ask_critic", READING + CRITIC_READING) if critic else (TOOLS, READING)
    source = corrected_runner((house / "r21_chains.py").read_text(), tools, reading, die_roll)
    template = (house / "brief_template.md").read_text()
    for placeholder in ("{OPENING}", "{STUDIO}", "{READING}"):
        if template.count(placeholder) != 1:
            raise ValueError("house brief template differs: " + placeholder)
    if die_roll:
        if template.count("## Working\n") != 1:
            raise ValueError("house brief template differs: Working")
        template = template.replace("## Working\n", DIE_ROLL_SECTION + "## Working\n")
    brief = template.replace("{OPENING}", OPENING).replace("{STUDIO}", str(studio)).replace("{READING}", reading)
    strip = runpy.run_path(str(Path(__file__).with_name("strip_sources")))["strip"]
    notes = strip(studio_notes.read_text())
    repo = Path(__file__).resolve().parent.parent
    copies = {name: house / name for name in ("painting_chunks.py", "defaults_used.py", "log_copy.py", "copied_shapes.py", "brief_template.md")}
    copies["run.py"] = repo / "harness/painter/run_friedrich.py"
    if die_roll:
        copies["die_roll.py"] = repo / "harness/painter/die_roll.py"
    contents = {name: path.read_bytes() for name, path in copies.items()}
    if die_roll:
        entrypoint = contents["run.py"].decode()
        hook = '    if R.paint("OPUS", 1, STUDIO, RUN / "OPUS") is None:\n'
        if entrypoint.count(hook) != 1:
            raise ValueError("prepared entrypoint differs: expected one paint call")
        contents["run.py"] = entrypoint.replace(hook, '    from die_roll import choose\n    R.DIE_ROLL_OPENING = choose(R, MODEL, STUDIO, RUN)\n' + hook).encode()
    guide = studio / "notes/easel_guide.md"
    critic_guide = None
    if critic and guide.is_file():
        text = guide.read_text()
        table = "| tool | what it does |\n|---|---|\n"
        start = text.index(table) + len(table)
        end = text.index("\n\n", start) + 1
        description = json.loads((repo / "harness/easel_mcp/critic-tools.json").read_text())[0]["description"]
        critic_guide = text[:end] + f"| `ask_critic` | {description} |\n" + text[end:]
    revision = subprocess.check_output(["git", "-C", str(repo), "rev-parse", "HEAD"]).decode().strip()
    runner.mkdir(parents=True)
    for name, data in contents.items():
        (runner / name).write_bytes(data)
        shutil.copystat(copies[name], runner / name)
    (runner / "r21_chains.py").write_text(source)
    (studio / "notes/studio_notes.md").write_text(notes)
    (runner / "studio_notes.md").write_text(notes)
    if die_roll:
        (runner / "brief_template.md").write_text(template)
    (runner / "run-config.json").write_text(json.dumps({"studio": str(studio), "source": str(repo), "source_revision": revision, "run": str(run_dir or runner / "run"), **({"critic": True} if critic else {}), **({"die_roll": True} if die_roll else {}), **({"painter": painter} if painter is not None else {}), **({"critic_model": critic_model} if critic_model is not None else {})}, indent=2) + "\n")
    (studio / "BRIEF.md").write_text(brief)
    if critic_guide is not None:
        guide.write_text(critic_guide)


def model_spec(value):
    provider, slash, rest = value.partition("/")
    model, colon, thinking = rest.rpartition(":")
    if not all((provider, slash, model, colon, thinking)):
        raise argparse.ArgumentTypeError("expected PROVIDER/MODEL:THINKING")
    return value


def main():
    parser = argparse.ArgumentParser(description="Prepare a new free-subject Friedrich studio and a corrected copy of the house runner, without launching it.")
    parser.add_argument("studio", type=Path)
    parser.add_argument("--house", type=Path, required=True)
    parser.add_argument("--runner-dir", type=Path, required=True)
    parser.add_argument("--studio-notes", type=Path, required=True)
    parser.add_argument("--run-dir", type=Path)
    parser.add_argument("--critic", action="store_true", help="a second painter visits as a critic (harness/painter/visit.ts)")
    parser.add_argument("--painter", type=model_spec, metavar="PROVIDER/MODEL:THINKING")
    parser.add_argument("--critic-model", type=model_spec, metavar="PROVIDER/MODEL:THINKING")
    parser.add_argument("--die-roll", action="store_true", help="write sixteen concepts in sitting 0, then roll among the six least common")
    args = parser.parse_args()
    if args.critic_model is not None and not args.critic:
        parser.error("--critic-model requires --critic")
    prepare(args.studio.resolve(), args.house.resolve(), args.runner_dir.resolve(), args.studio_notes.resolve(), args.run_dir.resolve() if args.run_dir else None, args.critic, args.die_roll, args.painter, args.critic_model)


if __name__ == "__main__":
    main()
