#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["mcp==1.30.0", "pillow"]
# ///
import argparse
import asyncio
import json
import os
from pathlib import Path
import subprocess
import sys
import time

from mcp import ClientSession, StdioServerParameters
from mcp.client.stdio import stdio_client

REPO = Path(__file__).resolve().parent.parent


async def main():
    parser = argparse.ArgumentParser(description="Offline real-easel fixture for studio/test_live.cjs; no model painter or VPS connection.")
    parser.add_argument("--studio", type=Path, required=True)
    parser.add_argument("--out", type=Path, required=True)
    args = parser.parse_args()
    studio = args.studio.resolve(strict=True)
    log = studio / "paintings/lua/painting.lua"
    if log.exists() and log.stat().st_size:
        parser.error("use a new empty exported studio")
    out = args.out.resolve()
    out.mkdir(parents=True, exist_ok=True)
    sessions = out / "sessions"
    sessions.mkdir(exist_ok=True)
    env = dict(os.environ, RAYON_NUM_THREADS="2")
    params = StdioServerParameters(command=sys.executable, args=[str(REPO / "harness/easel_mcp/server.py"), "--studio", str(studio), "--sessions-root", str(sessions)], env=env)
    publisher = None
    try:
        async with stdio_client(params) as (read, write):
            async with ClientSession(read, write) as client:
                await client.initialize()
                publisher_log = (out / "publisher.log").open("w")
                publisher = subprocess.Popen([sys.executable, str(REPO / "studio/publish_live.py"), "--painter", studio.name,
                    "--sessions-root", str(sessions), "--work-dir", str(out / "publisher"), "--local-root", str(out / "site/live/fixture"),
                    "--watch", "--interval", "0.2"], stdout=publisher_log, stderr=subprocess.STDOUT, env=env)

                async def call(name, arguments):
                    result = await client.call_tool(name, arguments)
                    if result.isError:
                        raise RuntimeError(result.content[0].text)
                    return result

                canvas = 'local t=tubes(); canvas{size=100,aspect=1.25,linen=15,ground={{pile={{t[1],1}},um=80,apply="knife"}}}'
                mark = 'local t=tubes(); b=brush("round",4); b:load(pile{{t[#t],1}},0.8); b:stroke({{200,300},{800,320}})'
                await call("paint", {"lua": canvas})
                await call("look", {"size": 320})
                await call("note", {"text": "First hosted fixture snapshot."})
                (out / "phase1").touch()
                deadline = time.monotonic() + 120
                while not (out / "continue").exists():
                    if time.monotonic() > deadline or publisher.poll() is not None:
                        raise RuntimeError("browser/publisher did not continue the fixture")
                    await asyncio.sleep(0.2)
                await call("paint", {"lua": mark})
                await call("look", {"size": 320})
                await call("note", {"text": "Second hosted fixture snapshot."})
                before = log.read_bytes()
                failed = await client.call_tool("paint", {"lua": 'error("fixture rollback")'})
                assert failed.isError and log.read_bytes() == before
                receipt = {"committed_chunks": 2, "failed_chunks": 1, "rollback_unchanged": True,
                           "transport": "local atomic copy", "cloud_machine": True, "vps_contacted": False, "model_painter": False}
                (out / "painting-receipt.json").write_text(json.dumps(receipt, indent=2) + "\n")
                deadline = time.monotonic() + 120
                while not (out / "done").exists():
                    if time.monotonic() > deadline or publisher.poll() is not None:
                        raise RuntimeError("browser/publisher did not finish the fixture")
                    await asyncio.sleep(0.2)
    finally:
        if publisher:
            publisher.terminate()
            await asyncio.to_thread(publisher.wait, 10)
            publisher_log.close()
        await asyncio.to_thread(subprocess.run, [str(studio / "bin/easel"), "close"], cwd=studio, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)


if __name__ == "__main__":
    asyncio.run(main())
