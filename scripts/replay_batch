#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""Run independent replay clips within a shared CPU budget, without building.

    scripts/replay_batch jobs.json --cpu-budget 16 --jobs 3 --easel /path/to/easel

jobs.json is a nonempty JSON array, for example:
    [{"log": "r40.lua", "out": "clips/r40.mp4", "workers": 4}]

Paths are relative to the manifest. Each job may set workers and encoder_threads;
defaults are 4 and 1. A job reserves max(workers, encoder_threads + 2) CPU slots
because clip replay and encoding are sequential, with one decoder and one filter
worker alongside x264. --jobs separately bounds concurrent jobs and memory use.
Each output gets its own .frames directory and .batch.log. Existing output paths
are refused. Failures are logged and the rest of the queue runs; any failure makes
the batch exit nonzero. SIGINT/SIGTERM stop all running jobs, including encoders.
The default clip is 600 frames at 30 fps in Gallery light.
"""

import argparse
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time


def positive(value):
    number = int(value)
    if number < 1:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return number


def load_jobs(manifest, args):
    rows = json.loads(manifest.read_text())
    if not isinstance(rows, list) or not rows:
        raise ValueError("manifest must be a nonempty JSON array")
    jobs, paths = [], []
    for index, row in enumerate(rows, 1):
        if not isinstance(row, dict) or set(row) - {"log", "out", "workers", "encoder_threads"}:
            raise ValueError(f"job {index}: expected log, out and optional workers/encoder_threads")
        for key in ("log", "out"):
            if not isinstance(row.get(key), str) or not row[key]:
                raise ValueError(f"job {index}: {key} must be a nonempty path string")
        log, out = [(manifest.parent / row[key]).resolve() for key in ("log", "out")]
        if not log.is_file():
            raise ValueError(f"job {index}: no log at {log}")
        workers = row.get("workers", args.workers)
        encoder = row.get("encoder_threads", args.encoder_threads)
        if any(type(n) is not int or n < 1 for n in (workers, encoder)):
            raise ValueError(f"job {index}: worker counts must be positive integers")
        slots = max(workers, encoder + 2)
        if slots > args.cpu_budget:
            raise ValueError(f"job {index}: needs {slots} CPU slots, budget is {args.cpu_budget}")
        checkpoint = Path(f"{out}.frames.replay.ckpt")
        owned = [out, Path(f"{out}.frames"), Path(f"{out}.frames.log"), Path(f"{out}.batch.log"),
                 checkpoint, checkpoint.with_suffix(".replay-progress.json")]
        for path in owned:
            if path.exists() or path.is_symlink():
                raise ValueError(f"job {index}: output path already exists: {path}")
            if path == log or path in log.parents:
                raise ValueError(f"job {index}: output overlaps input {log}")
            for other in paths + owned[:owned.index(path)]:
                if path == other or path in other.parents or other in path.parents:
                    raise ValueError(f"job {index}: output paths overlap: {path} and {other}")
        paths.extend(owned)
        jobs.append({"index": index, "log": log, "out": out, "workers": workers,
                     "encoder": encoder, "slots": slots})
    for job in jobs:
        if any(path == job["log"] or path in job["log"].parents for path in paths):
            raise ValueError(f"output overlaps input {job['log']}")
    return jobs


def run(jobs, args):
    pending, running, failed = list(jobs), [], False
    clip = Path(__file__).resolve().with_name("replay_clip")
    try:
        while pending or running:
            if args.canceled:
                return 130
            for job in running[:]:
                code = job["process"].poll()
                if code is None:
                    continue
                running.remove(job)
                job["stream"].close()
                failed |= code != 0
                print(f"job {job['index']}: exit {code}, {time.monotonic() - job['start']:.2f} s, {job['out']}", flush=True)
            if pending and len(running) < args.jobs:
                job = pending[0]
                if sum(j["slots"] for j in running) + job["slots"] <= args.cpu_budget:
                    pending.pop(0)
                    command = [str(clip), str(job["log"]), str(job["out"]), "--fps", str(args.fps),
                               "--light", args.light, "--encoder-threads", str(job["encoder"])]
                    if args.easel:
                        command.extend(["--easel", args.easel])
                    stream = None
                    try:
                        job["out"].parent.mkdir(parents=True, exist_ok=True)
                        stream = Path(f"{job['out']}.batch.log").open("x")
                        job["process"] = subprocess.Popen(command, stdout=stream, stderr=subprocess.STDOUT,
                                                          env={**os.environ, "RAYON_NUM_THREADS": str(job["workers"])},
                                                          start_new_session=True)
                    except OSError as error:
                        if stream is not None:
                            stream.close()
                        failed = True
                        print(f"job {job['index']}: failed to start: {error}", file=sys.stderr, flush=True)
                        continue
                    job["stream"] = stream
                    job["start"] = time.monotonic()
                    running.append(job)
                    print(f"job {job['index']}: started, {job['workers']} render workers, {job['encoder']} encoder workers", flush=True)
                    continue
            if running:
                time.sleep(0.05)
    finally:
        for job in running:
            try:
                os.killpg(job["process"].pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        if running:
            time.sleep(0.2)
        for job in running:
            try:
                os.killpg(job["process"].pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            job["process"].wait()
            job["stream"].close()
    return int(failed)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("manifest", type=Path)
    parser.add_argument("--cpu-budget", type=positive, default=len(os.sched_getaffinity(0)) if hasattr(os, "sched_getaffinity") else os.cpu_count() or 1)
    parser.add_argument("--jobs", type=positive, default=1)
    parser.add_argument("--workers", type=positive, default=4)
    parser.add_argument("--encoder-threads", type=positive, default=1)
    parser.add_argument("--fps", type=positive, default=30)
    parser.add_argument("--light", choices=("gallery", "color"), default="gallery")
    parser.add_argument("--easel", help="prebuilt replay binary; otherwise use replay_easel --no-build")
    args = parser.parse_args()
    try:
        jobs = load_jobs(args.manifest.resolve(), args)
    except (OSError, ValueError) as error:
        parser.error(str(error))
    args.canceled = False
    def stop(signum, frame):
        args.canceled = True
    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)
    try:
        code = run(jobs, args)
        if code == 130:
            print("replay_batch: canceled", file=sys.stderr)
        return code
    except OSError as error:
        print(f"replay_batch: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
