+//! Review probes (scratch copy only): the flow's clock phase (T05) and substep cap (T04).
+mod thinner_support;
+use paint::thinner::probe;
+use paint::{Canvas, Tool, hex};
+use thinner_support::*;
+
+fn l1(a: &[f32], b: &[f32]) -> f64 { a.iter().zip(b).map(|(x, y)| (x - y).abs() as f64).sum() }
+fn sum(a: &[f32]) -> f64 { a.iter().map(|&x| x as f64).sum() }
+
+/// T05: the same thinned patch, laid at different clock phases, then the same short wait.
+#[test]
+#[ignore = "review probe"]
+fn review_clock_phase() {
+    println!("[T05] same thinned patch (raw sienna, t 0.5, 300 px smooth canvas), laid at clock phase `start`, then wait 0.02 min");
+    println!("  start   clock_after_patch  flow calls in the 0.02 min  paint moved (L1 um-px)  share of all paint");
+    for start in [0.10f32, 0.50, 0.97, 0.99] {
+        let mut c = smooth_canvas(300);
+        c.wait(start);
+        thinned_patch(&mut c, raw_sienna(), 0.5, (150.0, 850.0), (300.0, 700.0), 51);
+        let t = c.clock();
+        let before = paint_um(&c);
+        probe::reset(64);
+        c.wait(0.02);
+        let after = paint_um(&c);
+        println!("  {start:5}   {t:17.4}  {:26}  {:22.3}  {:.4}%", probe::read().0, l1(&before, &after), 100.0 * l1(&before, &after) / sum(&before));
+    }
+    // how much the phase matters for the finished film: wait the solvent out from each phase
+    println!("[T05] the same patch after the solvent has gone (wait 40 min), against the patch laid at phase 0.01");
+    let run = |start: f32| {
+        let mut c = smooth_canvas(300);
+        c.wait(start);
+        thinned_patch(&mut c, raw_sienna(), 0.5, (150.0, 850.0), (300.0, 700.0), 51);
+        let laid = paint_um(&c);
+        c.wait(40.0);
+        (laid, paint_um(&c), c.solvent_total())
+    };
+    let (laid0, base, _) = run(0.01);
+    let flowed = l1(&laid0, &base);
+    println!("  (phase 0.01: the whole wait moved {:.2} um-px of paint, {:.3}% of it)", flowed, 100.0 * flowed / sum(&laid0));
+    for start in [0.25f32, 0.50, 0.75, 0.99] {
+        let (laid, end, solv) = run(start);
+        assert_eq!(laid, laid0, "the patch itself is laid alike at every phase");
+        let r = (250.0, 380.0, 750.0, 620.0);
+        let _ = r;
+        println!("  phase {start}: final paint differs from phase 0.01 by L1 {:.3} um-px = {:.2}% of all the flow that happened; solvent left {solv}", l1(&end, &base), 100.0 * l1(&end, &base) / flowed);
+    }
+}
+
+/// T04: does the 64-substep cap engage in a real thinned stroke at the painting's pixel size, and what does it change?
+#[test]
+#[ignore = "review probe"]
+fn review_substep_cap() {
+    println!("[T04] one thinned filbert stroke + 3 one-minute waits; canvas sized so one pixel is the painting's (440 mm / px)");
+    println!("  px_equiv  thinner  flow calls  capped calls  worst substeps needed  | paint L1 diff vs uncapped (um-px)  as share of what the uncapped flow moved");
+    for (px_equiv, px, mm) in [(2400usize, 600usize, 110.0f32), (3200, 800, 110.0), (4800, 1200, 110.0)] {
+        for t in [0.5f32, 0.8, 0.9, 0.95] {
+            let run = |max_sub: usize| {
+                let mut c = Canvas::new(px, 1.0, hex("#d8cdb8")).with_engine(3).with_size_mm(mm);
+                c.prime(hex("#b9a98c"), 0.9, 60.0, 0.6, 0.0, 7);
+                let mut h = brush(Tool::filbert(60.0), 71, raw_sienna().with_thinner(t), 0.8);
+                stroke(&mut c, &mut h, vec![(150.0, 480.0), (850.0, 520.0)], 0.8);
+                let laid = paint_um(&c);
+                probe::reset(max_sub);
+                for _ in 0..3 { c.wait(1.0); }
+                (laid, paint_um(&c), probe::read())
+            };
+            let (laid, capped, st) = run(64);
+            let (_, free, _) = run(1 << 20);
+            let moved = l1(&laid, &free);
+            println!("  {px_equiv:8}  {t:7}  {:10}  {:12}  {:21}  | {:33.4}  {:.1}%", st.0, st.1, st.2, l1(&capped, &free), if moved > 0.0 { 100.0 * l1(&capped, &free) / moved } else { 0.0 });
+        }
+    }
+}
+
+/// Follow-up: does a thinned stroke flow at all, and does the cap change anything when it does?
+#[test]
+#[ignore = "review probe"]
+fn review_flow_reach() {
+    println!("[G] 2400-px-equivalent pixels (110 mm canvas, 600 px), flat ground, filbert; `passes` strokes on the same path, then 3 one-minute waits");
+    println!("  thinner  passes  ceiling um  max liquid um  px above the 2 um wetting film  capped calls/3  paint moved by the flow (share of paint)  capped-vs-uncapped diff (share of moved)");
+    for (t, passes) in [(0.5f32, 1usize), (0.75, 1), (0.9, 1), (0.95, 1), (0.75, 5), (0.9, 5), (0.95, 5), (0.9, 12), (0.95, 12)] {
+        let run = |max_sub: usize| {
+            let mut c = Canvas::new(600, 1.0, hex("#d8cdb8")).with_engine(3).with_size_mm(110.0);
+            c.prime(hex("#b9a98c"), 0.9, 60.0, 0.6, 0.0, 7);
+            for k in 0..passes {
+                let mut h = brush(Tool::filbert(60.0), 71 + k as u64, raw_sienna().with_thinner(t), 0.8);
+                stroke(&mut c, &mut h, vec![(150.0, 480.0), (850.0, 520.0)], 0.8);
+            }
+            let laid = paint_um(&c);
+            let liquid = wet_film(&c);
+            probe::reset(max_sub);
+            for _ in 0..3 { c.wait(1.0); }
+            (laid, liquid, paint_um(&c), probe::read())
+        };
+        let (laid, liquid, capped, st) = run(64);
+        let (_, _, free, _) = run(1 << 20);
+        let moved = l1(&laid, &free);
+        let above = liquid.iter().filter(|&&v| v > 2.0).count();
+        println!("  {t:7}  {passes:6}  {:10.3}  {:13.3}  {above:30}  {:14}  {:39.4}%  {:.1}%", paint::thinner::stroke_limit_um(t), liquid.iter().cloned().fold(0.0, f32::max), st.1, 100.0 * moved / sum(&laid).max(1e-12), if moved > 0.0 { 100.0 * l1(&capped, &free) / moved } else { 0.0 });
+    }
+}
