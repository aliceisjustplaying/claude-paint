#!/usr/bin/env bash
# Finish a painter's painting after the session: from the save file its
# session wrote when it closed (<studio>/out/easel/<name>/live.ckpt; `easel
# finish`, seconds), or, with no save, by replaying its log. The Friedrich
# studio gets varnish and cracks; every other studio keeps its final state.
# The log's box records the artist profile selected by export_r16_studio.
# Painters don't finish their own pictures (painter mode has no
# varnish{}, cracks{} or relief()),
# so that varnishing can't become their way of ending.
#
#   scripts/finish_painting <studio>/paintings/lua/painting.lua <out.png> [options]
#
# options (Friedrich only):
#   --coats C     varnish coats (default 0.4, the easel's default)
#   --no-varnish  skip the varnish
#   --no-cracks   skip the cracks
#   --relief      also light the surface's relief (the easel's default strength)
#
# Writes <out.png> (at the painting's width, like `easel save`) and, beside it, <out>.lua:
# the painter's log, with a finishing chunk only for Friedrich, which `easel run`
# replays to the same picture. Uses the replay build (default features:
# `replay` and `finish`), built from this checkout. A save that isn't of
# this log (another chunk count or text) is passed over for the replay.
# After a finish from the save, the save is compressed (zstd, else gzip:
# live.ckpt.zst or .gz), which scripts/check_painting also reads.
set -euo pipefail
# the log names its box, and the replay takes it from there: a box set in
# the caller's environment (EASEL_BOX) would only make the easel refuse the log
unset EASEL_BOX

usage() { echo "usage: $0 <painting.lua> <out.png> [--coats C] [--no-varnish] [--no-cracks] [--relief]" >&2; exit 2; }
[ $# -ge 2 ] || usage
log=$1; out=$2; shift 2
coats=0.4; varnish=1; cracks=1; relief=0
while [ $# -gt 0 ]; do
  case "$1" in
    --coats) [ $# -ge 2 ] || usage; coats=$2; shift 2 ;;
    --no-varnish) varnish=0; shift ;;
    --no-cracks) cracks=0; shift ;;
    --relief) relief=1; shift ;;
    *) usage ;;
  esac
done
[[ $coats =~ ^([0-9]+\.?[0-9]*|\.[0-9]+)$ ]] || { echo "--coats takes a number, not '$coats'" >&2; exit 2; }
[ -f "$log" ] || { echo "no log at $log" >&2; exit 1; }
box=$(awk '/^[[:space:]]*--@ chunk/ { exit }
  /^[[:space:]]*--@ box / {
    sub(/^[[:space:]]*--@ box[[:space:]]*/, ""); sub(/[[:space:]]*$/, ""); print; exit
  }' "$log")
if [ "$box" != friedrich ]; then
  varnish=0
  cracks=0
  relief=0
fi

repo=$(cd "$(dirname "$0")/.." && pwd)
# the replay build, in the target directory cargo builds into (CARGO_TARGET_DIR too)
easel=$("$repo/scripts/replay_easel")

# The finishing chunk (crates/easel/src/finish.rs `chunk`): wait a month at a
# time until every film is touch-dry (the finishing verbs refuse wet paint),
# for at most ten years, then finish.
opts=(--coats "$coats")
[ $varnish = 1 ] || opts+=(--no-varnish)
[ $cracks = 1 ] || opts+=(--no-cracks)
[ $relief = 1 ] && opts+=(--relief)
finishing=$("$easel" finish --print-chunk "${opts[@]}")

mkdir -p "$(dirname "$out")"
finished=${out%.png}.lua
# the finished log goes next to the PNG: never over the log being finished
if [ "$finished" -ef "$log" ]; then
  echo "finish_painting: $finished is the log itself; write the PNG under another name or folder" >&2
  exit 1
fi
{ cat "$log"; [ -z "$finishing" ] || printf '\n--@ chunk (finishing)\n%s\n' "$finishing"; } > "$finished.part"
mv "$finished.part" "$finished"

# the save the painter's session wrote when it closed: <studio>/out/easel/<name>/live.ckpt
name=$(basename "$log" .lua)
save=$(cd "$(dirname "$log")/../.." && pwd)/out/easel/$name/live.ckpt
for candidate in "$save" "$save.zst" "$save.gz"; do
  [ -f "$candidate" ] || continue
  input=$candidate
  temporary=
  if [[ $candidate = *.gz ]]; then
    temporary=$(mktemp "${TMPDIR:-/tmp}/finish-save.XXXXXX")
    trap 'rm -f "$temporary"' EXIT
    if ! gzip -dc "$candidate" > "$temporary"; then
      echo "finish_painting: couldn't read saved end state $candidate; trying the next save" >&2
      rm -f "$temporary"
      trap - EXIT
      continue
    fi
    input=$temporary
  fi
  if "$easel" finish "$input" "$out" --log "$log" "${opts[@]}"; then
    if [ "$candidate" = "$save" ]; then
      if command -v zstd >/dev/null; then zstd -q -T2 --rm -f "$save"; else gzip -1 -f "$save"; fi
    fi
    echo "finished from the save: $out (log: $finished; saved end state: $candidate; no replay)"
    exit 0
  fi
  [ -z "$temporary" ] || rm -f "$temporary"
  trap - EXIT
  echo "finish_painting: saved end state $candidate didn't match or couldn't finish; trying the next save" >&2
done
echo "finish_painting: no usable matching saved end state; replaying the full log $log" >&2
"$easel" run "$finished" --out "$out" --replay-checkpoint "$out.replay.ckpt"
rm -f "$out.replay.ckpt"
echo "finished: $out (log: $finished)"
