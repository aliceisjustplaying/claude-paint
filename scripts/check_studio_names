#!/usr/bin/env bash
# Painters' names in an exported studio: none anywhere a painter can read
# (notes/, bin/box and the strings of bin/easel; bin/THIRD_PARTY_NOTICES.md,
# the legal notices, aside) but the studio's own artist's.
#
#   scripts/check_studio_names <studio> [own name ...]
#
# Names match case-insensitively as whole words; a name's space or hyphen
# matches a space, a hyphen or nothing ("Alma-Tadema", "Alma Tadema",
# "da Vinci", "da-Vinci", "DaVinci"). The easel's strings run together (a
# box's name between two tube names), so the names that are boxes are looked
# for inside words there too. Exits 1 and lists the hits if there are any.
# (scripts/export_r16_studio runs it; scripts/tests/studio_names.sh tests it.)
set -euo pipefail
[ $# -ge 1 ] || { echo "usage: $0 <studio> [own name ...]" >&2; exit 2; }
dest=$1
shift
own=("$@")

artists=(Friedrich Turner 'C[eé]zanne' Rembrandt Vermeer Renoir 'Van Gogh' Eckersberg Carus Kersting Constable Monet Manet Bruegel Brueghel Hockney Ruisdael Hobbema Cuyp Lorrain Poussin Corot Titian Tiziano Rubens 'Vel[aá]zquez' Goya Leonardo 'da Vinci' Vinci Michelangelo Raphael Ingres Delacroix Boucher Troyon Oudry Desportes Dahl Blechen Runge Oehme Kobell Gainsborough Whistler Sargent Degas Hopper Munch Picasso Matisse Kandinsky 'Bob Ross' Winsor Inness Alma-Tadema Tadema Tonn)
# the names that are also boxes (checked inside words in the binary)
box_artists=(Sargent Inness Tadema Tonn)

mine() { local o; for o in ${own[@]+"${own[@]}"}; do [ "$1" = "$o" ] && return 0; done; return 1; }
# a name as a pattern: its spaces and hyphens match a space, a hyphen or nothing
pat() { sed 's/[- ]/[- ]?/g' <<<"$1"; }
others=()
for a in "${artists[@]}"; do mine "$a" || others+=("$(pat "$a")"); done
box_names=()
for a in "${box_artists[@]}"; do mine "$a" || box_names+=("$a"); done
pattern=$(IFS='|'; echo "${others[*]}")
boxes_pattern=$(IFS='|'; echo "${box_names[*]}")

# every search reads a whole captured text, never a stream it stops early
# (under pipefail, `strings | grep -q` fails with SIGPIPE when grep finds a
# name, and reads as no hit)
hits=$(cd "$dest" && grep -rIniwE "$pattern" notes bin/box 2>/dev/null || true)
bin_strings=$(strings "$dest/bin/easel")
found=$(grep -iwoE "$pattern" <<<"$bin_strings" | sort -u | tr '\n' ' ' || true)
[ -z "$found" ] || hits+=$'\n'"bin/easel: $found"
if [ -n "$boxes_pattern" ]; then
  found=$(grep -ioE "$boxes_pattern" <<<"$bin_strings" | sort -u | tr '\n' ' ' || true)
  [ -z "$found" ] || hits+=$'\n'"bin/easel (inside words): $found"
fi
if [ -n "${hits//[$'\n']/}" ]; then
  echo "painters' names in $dest:" >&2
  echo "$hits" >&2
  exit 1
fi
