#!/usr/bin/env python3
import argparse
import json
from pathlib import Path
import re


def registration(log, secret_name="EASEL_MCP_AUTHORIZATION"):
    urls = re.findall(r"https://[a-z0-9-]+\.trycloudflare\.com\b", log)
    if not urls:
        raise ValueError("no quick-tunnel URL found in the cloudflared log")
    return {
        "source": {"transport": {
            "type": "http", "url": urls[-1] + "/mcp",
            "auth": {"type": "headers", "credential_header_names": ["Authorization"]},
        }},
        "server_key": "easel-remote", "display_name": "Easel remote",
        "secrets": {"credential_header:Authorization": {"project_env": secret_name}},
        "reason": "Paint at the Mac easel and show its looks in the studio.",
    }


def main():
    parser = argparse.ArgumentParser(description="Print a remote MCP registration from the latest quick-tunnel URL.")
    parser.add_argument("log", type=Path)
    parser.add_argument("--secret-name", default="EASEL_MCP_AUTHORIZATION")
    args = parser.parse_args()
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", args.secret_name):
        parser.error("secret-name must be an environment variable name")
    try:
        config = registration(args.log.expanduser().read_text(), args.secret_name)
    except ValueError as error:
        parser.error(str(error))
    print(json.dumps(config, indent=2))


if __name__ == "__main__":
    main()
