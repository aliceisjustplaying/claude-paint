#!/usr/bin/env bash
# replay_clip: a clip of an easel painting being made at the pace of the hand.
#
#   scripts/replay_clip <painting.lua> <out.mp4> [options]
#
#   --every S        record a frame every S seconds of hand time (default 60)
#   --length T       the clip's length in seconds, final hold included
#                    (default 75)
#   --pace P         screen time goes as hand time^P (default 0.6): the
#                    painting's first hours play slower and later hours
#                    faster, so the long fine-detail stretch at the end doesn't
#                    drag; 1 plays hand time evenly throughout
#   --pace dynamic   screen time follows how much the picture visibly changes
#                    (scripts/replay_pace.py, needs uv): each frame is held
#                    for (1 - floor) of its change^gamma share plus floor of
#                    its hand_time^0.6 share; frames under 2 video frames are
#                    skipped, so nothing flickers
#   --floor F        dynamic: the hand-time share (default 0.2)
#   --gamma G        dynamic: the change exponent (default 0.7)
#   --ramp R         dynamic: the opening plays faster, weight x R at the start
#                    easing to x1 over --ramp-span (share of hand time, 0.35)
#   --open-hold S    dynamic: show the bare canvas for S seconds first (default
#                    0), taken out of the rest so the clip still runs --length
#   --final-first S  open on the finished painting for S seconds, then cut to
#                    the start (default 0); taken out of --length, so the
#                    painting is paced into --length - S - the final hold
#   --width W        frame and clip width, px (default 1000)
#   --frames-dir D   where the frames go (default: <out>.frames); with
#                    --reuse, an existing frames dir to cut from
#   --reuse          don't replay; cut the clip from --frames-dir
#   --max-hold F     no frame is held longer than F seconds (default 1); a
#                    --length that would need longer holds is refused, with
#                    the longest the cap allows
#   --easel PATH     the easel binary (default: the replay build in the target
#                    directory cargo builds into, CARGO_TARGET_DIR too; not built here)
#   --sheet PATH     also a contact sheet: 12 frames spread evenly over the
#                    clip, 4 x 3 at 400 px (JPEG)
#
# The replay (`easel run --frames-every`) writes a frame whenever the hand
# time crosses the next multiple of S (the waits for drying are not hand
# time, so they vanish), one per chunk and the final canvas, plus
# frames.tsv with each frame's hand time. Each frame is then shown for as
# long as the hand took until the next one, compressed by --pace and capped
# by --max-hold; the final picture is held 3 s. H.264, yuv420p, faststart,
# 24 fps. A clip that doesn't come out --length long, to within a video
# frame, is an error.
set -euo pipefail
# the log names its box, and the replay takes it from there: a box set in
# the caller's environment (EASEL_BOX) would only make the easel refuse the log
unset EASEL_BOX

usage() { awk 'NR > 1 && !/^#/ { exit } NR > 1' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
[ $# -ge 2 ] || usage
log=$1 out=$2; shift 2
every=60 length=75 pace=0.6 width=1000 dir="" sheet="" floor=0.2 gamma=0.7 ramp=1 rampspan=0.35 openhold=0 finalfirst=0 reuse=0 maxhold=1 fps=24 hold=3
easel=""
while [ $# -gt 0 ]; do
  case $1 in
    --every) every=$2; shift 2 ;;
    --length) length=$2; shift 2 ;;
    --pace) pace=$2; shift 2 ;;
    --floor) floor=$2; shift 2 ;;
    --gamma) gamma=$2; shift 2 ;;
    --ramp) ramp=$2; shift 2 ;;
    --ramp-span) rampspan=$2; shift 2 ;;
    --open-hold) openhold=$2; shift 2 ;;
    --final-first) finalfirst=$2; shift 2 ;;
    --width) width=$2; shift 2 ;;
    --frames-dir) dir=$2; shift 2 ;;
    --reuse) reuse=1; shift ;;
    --max-hold) maxhold=$2; shift 2 ;;
    --easel) easel=$2; shift 2 ;;
    --sheet) sheet=$2; shift 2 ;;
    *) usage ;;
  esac
done
command -v ffmpeg >/dev/null || { echo "replay_clip: needs ffmpeg" >&2; exit 1; }
dir=${dir:-$out.frames}

if [ "$reuse" = 0 ]; then
  [ -n "$easel" ] || easel=$("$(dirname "$0")/replay_easel" --no-build)
  [ -x "$easel" ] || { echo "replay_clip: no easel at $easel (cargo build --release -p easel)" >&2; exit 1; }
  # only a frames folder of ours (or nothing, or an empty folder) is replaced
  if [ -e "$dir" ] && [ ! -f "$dir/frames.tsv" ] && [ -n "$(ls -A "$dir" 2>/dev/null)" ]; then
    echo "replay_clip: $dir exists and isn't a frames folder (no frames.tsv); not replacing it" >&2
    exit 1
  fi
  rm -rf "$dir"
  t0=$(date +%s)
  "$easel" run "$log" --out "$dir/final-full.png" --frames-every "$every" --frames-dir "$dir" --frame-width "$width" >/dev/null 2>"$dir.log" \
    || { tail -20 "$dir.log" >&2; exit 1; }
  grep -E '^(frames|wrote)' "$dir.log" >&2
  echo "replay took $(( $(date +%s) - t0 )) s" >&2
fi
[ -f "$dir/frames.tsv" ] || { echo "replay_clip: no $dir/frames.tsv" >&2; exit 1; }

# the concat list: each distinct moment (frames at the same hand time: the
# last one, as it is after any wait) held for its share of the clip: the
# hand time to the next moment, measured on the curve hand_time^pace, scaled
# so the clip runs --length (holds capped at --max-hold, the rest stretched
# to make up for them)
list=$dir/concat.txt
# the time the painting is paced into: --length less the opening on the finished painting
plength=$(awk -v l="$length" -v f="$finalfirst" 'BEGIN { printf "%.5f", l - f }')
if [ "$pace" = dynamic ]; then
  command -v uv >/dev/null || { echo "replay_clip: --pace dynamic needs uv" >&2; exit 1; }
  uv run -q --script "$(dirname "$0")/replay_pace.py" "$dir" --length "$plength" --max-hold "$maxhold" --hold "$hold" \
    --fps "$fps" --floor "$floor" --gamma "$gamma" --ramp "$ramp" --ramp-span "$rampspan" --open-hold "$openhold" \
    --before "$finalfirst" --eval
else
# entries are file names: ffmpeg reads them relative to the list, which is in $dir
awk -F'\t' -v fps="$fps" -v length_="$plength" -v pace="$pace" -v hold="$hold" -v maxhold="$maxhold" -v ff="$finalfirst" -v q="'" '
  # a name in quotes in the list: each quote in it closes, escapes and reopens
  function esc(s,  r, i) { r = ""; while ((i = index(s, q)) > 0) { r = r substr(s, 1, i - 1) q "\\" q q; s = substr(s, i + 1) } return r s }
  NR == 1 { next }
  { if (n > 0 && $2 + 0 == h[n]) { f[n] = $1 } else { n++; f[n] = $1; h[n] = $2 + 0 } }
  END {
    if (length_ <= hold) { print "replay_clip: --length must exceed the " hold " s final hold" > "/dev/stderr"; exit 1 }
    for (i = 1; i < n; i++) w[i] = h[i + 1] ^ pace - h[i] ^ pace
    want = length_ - hold; m = 0
    for (i = 1; i < n; i++) if (w[i] > 0) m++
    # the moments shown, each held at most --max-hold, may not fill --length
    if (want > m * maxhold + 1e-6) {
      msg = sprintf("replay_clip: --length %s is longer than the clip can run: %d moment%s held at most %s s each (--max-hold) plus the %s s final hold", length_ + ff, m, m == 1 ? "" : "s", maxhold, hold)
      if (ff > 0) msg = msg sprintf(" plus the %s s --final-first", ff)
      msg = msg sprintf(" come to at most %.2f s; ", int((m * maxhold + hold + ff) * 100 + 1e-6) / 100)
      if (m > 0) msg = msg sprintf("raise --max-hold to at least %.2f or ", int(want / m * 100 + 0.999999) / 100)
      print msg "lower --length" > "/dev/stderr"; exit 1
    }
    # scale: capped holds take max-hold, the rest share the remaining time
    k = 0
    for (it = 0; it < 20; it++) {
      capped = 0; free = 0
      for (i = 1; i < n; i++) if (k > 0 && w[i] * k > maxhold) capped += maxhold; else free += w[i]
      if (free <= 0) break
      k2 = (want - capped) / free
      if (k2 == k) break
      k = k2
    }
    secs = 0
    for (i = 1; i < n; i++) {
      d = w[i] * k
      if (d > maxhold) d = maxhold
      if (d <= 0) continue
      printf "file '\''%s'\''\nduration %.5f\n", esc(f[i]), d
      secs += d
    }
    if (secs - want > 0.5 / fps || want - secs > 0.5 / fps) { printf "replay_clip: the holds come to %.3f s, not %.3f\n", secs, want > "/dev/stderr"; exit 1 }
    # the last entry of a concat list takes the duration before it, so the
    # hold (less the two frames after it) is followed by a one-frame repeat
    # and then the frame again (a frame)
    printf "file '\''%s'\''\nduration %.5f\n", esc(f[n]), hold - 2 / fps
    printf "file '\''%s'\''\nduration %.5f\nfile '\''%s'\''\n", esc(f[n]), 1 / fps, esc(f[n])
    printf "%d moments, %.1f min of hand time, pace %s: about %.1f s of clip\n", n, h[n] / 60, pace, secs + hold > "/dev/stderr"
  }' "$dir/frames.tsv" > "$list"
fi

if awk -v f="$finalfirst" 'BEGIN { exit !(f > 0) }'; then
  # the finished painting first (the last frame, as the final hold shows it)
  last=$(tail -1 "$dir/frames.tsv" | cut -f1) q="'"
  { printf "file '%s'\nduration %.5f\n" "${last//$q/$q\\$q$q}" "$finalfirst"; cat "$list"; } > "$list.tmp" && mv "$list.tmp" "$list"
fi

ffmpeg -loglevel error -y -f concat -safe 0 -i "$list" \
  -vf "fps=$fps,scale='min($width,iw)':-2:flags=lanczos,format=yuv420p" \
  -c:v libx264 -crf 23 -preset slow -movflags +faststart "$out"
ffprobe -v error -show_entries format=duration,size:stream=width,height,nb_frames -of compact "$out" >&2
got=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$out")
awk -v g="$got" -v l="$length" -v fps="$fps" 'BEGIN { d = g - l; exit !(d * d <= (1 / fps + 1e-6) ^ 2) }' \
  || { echo "replay_clip: $out runs $got s, not the $length s asked for" >&2; exit 1; }

if [ -n "$sheet" ]; then
  dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$out")
  rm -rf "$dir/sheet"; mkdir -p "$dir/sheet"
  for i in $(seq 0 11); do
    t=$(awk -v d="$dur" -v i="$i" 'BEGIN { printf "%.2f", i * (d - 0.2) / 11 }')
    ffmpeg -loglevel error -y -ss "$t" -i "$out" -frames:v 1 -vf scale=400:-2 "$dir/sheet/$(printf %02d "$i").png"
  done
  ffmpeg -loglevel error -y -framerate 1 -i "$dir/sheet/%02d.png" -vf "tile=4x3:padding=4:color=white" -frames:v 1 -q:v 3 "$sheet"
  echo "sheet: $sheet" >&2
fi
