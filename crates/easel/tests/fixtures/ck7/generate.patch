+#[cfg(feature = "replay")]
+fn ck7_fixture(args: &[String]) -> Result<(), String> {
+    let dir = Path::new(args.first().ok_or("ck7-fixture DIR")?);
+    std::fs::create_dir_all(dir).map_err(|e| e.to_string())?;
+    let mut s = Session::replay(32).map_err(|e| e.to_string())?;
+    for chunk in [
+        r#"canvas{size=440, aspect=1.25, linen=15, seed=7, ground={{pile={{"lead white", 3}, {"yellow ochre", 1}}, um=120, apply="knife"}}}"#,
+        r#"p = pile{{"lead white", 4}, {"cobalt blue", 1}, medium=0.3}; work(rect(0, 0, 550, 500), {hand="body", pile=p, coverage=2})"#,
+        r#"wait(30); work(rect(550, 200, 400, 400), {hand="broad", pile=pile{{"bone black", 1}, {"raw umber", 1}}, coverage=1.5})"#,
+    ] { s.run(chunk).map_err(|e| e.to_string())?; }
+    let source = s.program("ck7-fixture");
+    std::fs::write(dir.join("painting.lua"), &source).map_err(|e| e.to_string())?;
+    save_fixture::write(&s, &source, &dir.join("live.ckpt"))?;
+    let canvas = s.canvas().ok_or("missing fixture canvas")?;
+    deliver(&canvas, &dir.join("color.png"))?;
+    Ok(())
+}
