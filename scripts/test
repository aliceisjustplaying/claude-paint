#!/usr/bin/env bash
# The claude-paint gate: one test-profile build of the workspace, then the
# retained checks (notes/speed/SKIPPED.md), at most four at a time. A check
# passes only if it exits 0 and prints what proves its tests ran: every named
# Rust test's ok line, or a count of at least one. The registered rag
# baseline mismatch (exit 4 with KNOWN_FAILURE: rag-historical-baseline-main)
# and the isolated knife single-test failure are reported as known.
# Exit 0 if nothing else failed, 1 otherwise.
#
#   scripts/test          (CARGO_TARGET_DIR is honored; a failed run keeps its logs)
set -uo pipefail
[ $# -eq 0 ] || { echo "usage: scripts/test" >&2; exit 2; }
repo=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo" || exit 1
# no __pycache__ in the checkout: one breaks the baseline package's file list
export PYTHONDONTWRITEBYTECODE=1
# the checks pick their boxes themselves
unset EASEL_BOX
work=$(mktemp -d "${TMPDIR:-/tmp}/gate.XXXXXX")
declare -A name_of=()
stop() {
  trap - INT TERM
  for p in "${!name_of[@]}"; do pkill -TERM -s "$p"; done
  wait
  rm -rf "$work"
  exit 130
}
trap stop INT TERM

# launch NAME COMMAND: runs COMMAND in its own session (perl: macOS has no setsid), output in $work/NAME.log
launch() {
  mkdir -p "$work/$1.tmp"
  echo "$EPOCHREALTIME" >"$work/$1.t0"
  TMPDIR=$work/$1.tmp perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' bash -c "$2" >"$work/$1.log" 2>&1 </dev/null &
  name_of[$!]=$1
}

# reap: waits for one launched command, stops what it left running (a crashed test's easel
# server) and records its exit and wall time
reap() {
  local pid rc name
  wait -n -p pid
  rc=$?
  name=${name_of[$pid]}
  unset "name_of[$pid]"
  pkill -KILL -s "$pid"
  echo "$rc" >"$work/$name.rc"
  awk -v a="$(cat "$work/$name.t0")" -v b="$EPOCHREALTIME" 'BEGIN { printf "%.1f", b - a }' >"$work/$name.secs"
}

t0=$EPOCHREALTIME
launch build "cargo test --workspace --features easel/state-store --no-run --config profile.test.debug=0 --lib --bin easel --test smoke --test look --test session_integrity --test live_frames --test live_replay_checkpoint --test replay_frames_resume --test painter_signals --test studio_profiles --test checkpoint_paths --test save_confined --test ck7 --test thinner_physics --test thinner_pigments --message-format=json-render-diagnostics >$(printf %q "$work/build.json")"
reap
if [ "$(cat "$work/build.rc")" != 0 ]; then
  cat "$work/build.log"
  echo "gate: the build FAILED"
  exit 1
fi
echo "gate: built in $(cat "$work/build.secs") s"
if ! uv run --no-project python scripts/cargo_test_executables.py "$work/build.json" >"$work/exes"; then
  echo "gate: the build artifact stream FAILED (logs: $work)"
  exit 1
fi
exe() { awk -F'\t' -v k="$1" '$1 == k { print $2 }' "$work/exes"; }
easel=$(exe 'bin easel')
[ -x "$easel" ] || { echo "gate: the build made no easel executable"; exit 1; }
easel=$(printf %q "$easel")

names=() cmds=() wants=()
declare -A known_rust_tests=()
# check NAME COMMAND WANT: WANT is newline-separated regexes, each of which must match a line of the output
check() { names+=("$1"); cmds+=("$2"); wants+=("$3"); }
# rust NAME CRATE TARGET [TEST...]: a test executable, run from its crate as cargo does; each named
# test (ignored ones too) must print ok, or with no names the executable must pass at least one test
rust() {
  local name=$1 crate=$2 bin want='^test result: ok\. [1-9]' t
  bin=$(exe "$3")
  [ -z "$bin" ] || bin=$(printf %q "$bin")
  shift 3
  if [ $# -gt 0 ]; then
    want=
    for t in "$@"; do want+="^test $t \\.\\.\\. ok\$"$'\n'; done
  fi
  check "$name" "cd crates/$crate && ${bin:-missing-test-executable} $* ${*:+--exact --include-ignored}" "$want"
}
known_rust() {
  rust "$@"
  known_rust_tests[$1]=$4
}
# shellcheck disable=SC2016 # expanded by the check's own shell
pytest='mkdir -p "$TMPDIR/home" && uv run --no-project --with pytest --with pillow env HOME="$TMPDIR/home" python -m pytest -q -p no:cacheprovider --basetemp "$TMPDIR/pytest"'
passed='[1-9][0-9]* passed'
unittest=$'^Ran [1-9]\n^OK'

