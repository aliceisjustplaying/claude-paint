#!/usr/bin/env bash
# Export the Round 16 studio for one painter.
#
#   scripts/export_r16_studio <profile> <dest>
#
# profile: friedrich  the easel, the engine, the easel guide, the materials
#                     note (notes/research/friedrich_materials.md) and the
#                     physics note
#          blank      the same without the materials note; nothing a painter
#                     can read names a painter (checked below)
# dest:    a folder that doesn't exist yet (or is empty)
#
# The files come from `git archive` of the r16-base branch through a fixed
# list (no .git, no target, no out, no developer notes). The easel is then
# built fresh in dest (`cargo build --release -p easel`), and dest gets an
# empty notes/journal.md.
set -euo pipefail

usage() { echo "usage: $0 friedrich|blank <dest>" >&2; exit 2; }
[ $# -eq 2 ] || usage
profile=$1
dest=$2
case "$profile" in friedrich|blank) ;; *) usage ;; esac

repo=$(cd "$(dirname "$0")/.." && pwd)
branch=${R16_BRANCH:-r16-base}
git -C "$repo" rev-parse --verify -q "$branch" >/dev/null || { echo "no branch $branch in $repo" >&2; exit 1; }

if [ -e "$dest" ] && [ -n "$(ls -A "$dest" 2>/dev/null)" ]; then
  echo "$dest exists and isn't empty" >&2
  exit 1
fi
mkdir -p "$dest"
dest=$(cd "$dest" && pwd)

# what a painter gets
files=(
  .cargo/config.toml
  .gitignore
  Cargo.lock
  Cargo.toml
  README.md
  THIRD_PARTY_NOTICES.md
  crates/easel
  crates/paint
  notes/easel_guide.md
  notes/research/oil_paint_physics.md
)
if [ "$profile" = friedrich ]; then
  files+=(notes/research/friedrich_materials.md)
fi

git -C "$repo" archive --format=tar "$branch" -- "${files[@]}" | tar -x -C "$dest"
: > "$dest/notes/journal.md"
mkdir -p "$dest/paintings/lua"

# names of painters: none anywhere a painter can read in the blank studio
# (legal notices aside); in the friedrich studio only Friedrich's
artists='Friedrich|Turner|C[eé]zanne|Rembrandt|Vermeer|Renoir|Van Gogh|Eckersberg|Carus|Kersting|Constable|Monet|Manet|Bruegel|Brueghel|Hockney|Ruisdael|Hobbema|Cuyp|Lorrain|Poussin|Corot|Titian|Tiziano|Rubens|Vel[aá]zquez|Goya|Leonardo|Michelangelo|Raphael|Ingres|Delacroix|Boucher|Troyon|Oudry|Desportes|Dahl|Blechen|Runge|Oehme|Kobell|Gainsborough|Whistler|Sargent|Degas|Hopper|Munch|Picasso|Matisse|Kandinsky|Bob Ross'
case "$profile" in
  blank) pattern=$artists ;;
  friedrich) pattern=${artists#Friedrich|} ;;
esac
hits=$(cd "$dest" && grep -rIniwE "$pattern" --exclude=THIRD_PARTY_NOTICES.md . || true)
if [ -n "$hits" ]; then
  echo "painters' names in the $profile studio:" >&2
  echo "$hits" >&2
  exit 1
fi

# build the easel fresh (fall back to the command line tools if Xcode's
# license blocks linking)
build() { (cd "$dest" && env -u CARGO_TARGET_DIR cargo build --release -p easel "$@"); }
if ! out=$(build 2>&1); then
  if echo "$out" | grep -qi 'license'; then
    DEVELOPER_DIR=/Library/Developer/CommandLineTools build
  else
    echo "$out" >&2
    exit 1
  fi
fi
[ -x "$dest/target/release/easel" ] || { echo "no easel built in $dest" >&2; exit 1; }

echo "exported the $profile studio from $branch ($(git -C "$repo" rev-parse --short "$branch")) to $dest"
echo "  easel: $dest/target/release/easel"
echo "  notes: $(cd "$dest/notes" && find . -type f | sed 's|^\./||' | sort | tr '\n' ' ')"
