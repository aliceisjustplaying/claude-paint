 const MAX_SUBSTEPS: usize = 64;
+// ---- review probe (scratch copy only) ----
+pub mod probe {
+    use std::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+    pub static MAX_SUB: AtomicUsize = AtomicUsize::new(64);
+    pub static CALLS: AtomicUsize = AtomicUsize::new(0);
+    pub static CAPPED: AtomicUsize = AtomicUsize::new(0);
+    pub static WORST_NEED: AtomicUsize = AtomicUsize::new(0);
+    pub fn reset(max_sub: usize) { MAX_SUB.store(max_sub, Relaxed); CALLS.store(0, Relaxed); CAPPED.store(0, Relaxed); WORST_NEED.store(0, Relaxed); }
+    pub fn read() -> (usize, usize, usize) { (CALLS.load(Relaxed), CAPPED.load(Relaxed), WORST_NEED.load(Relaxed)) }
+}
