#!/usr/bin/env python3
"""Small exact-state timing report. Timings are observations, never thresholds."""
import argparse
import json
import os
from pathlib import Path
import re
import resource
import shutil
import subprocess
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--easel", type=Path)
    p.add_argument("--output", type=Path)
    p.add_argument("--widths", nargs="+", type=int, default=[600, 2400])
    p.add_argument("--scenes", nargs="+", default=["r19", "mixed", "wash", "ground"])
    p.add_argument("--report-only", action="store_true")
    a = p.parse_args()
    if shutil.disk_usage(ROOT).free < 15 * 1024**3:
        raise SystemExit("bench_exact: fewer than 15 GiB free")
    binary = a.easel.resolve() if a.easel else ROOT / "target/release/easel"
    if not a.easel:
        subprocess.run(["nice", "-n", "10", "cargo", "build", "--release", "--locked", "-p", "easel", "--target-dir", str(ROOT / "target")], cwd=ROOT, check=True)
    results = []
    with tempfile.TemporaryDirectory(prefix="paint-bench-") as scratch:
        env = dict(os.environ)
        env["EASEL_GROUND_CACHE"] = "off"
        for width in a.widths:
            for name in a.scenes:
                src = ROOT / ("crates/easel/tests/r19_default_box.lua" if name == "r19" else f"scripts/bench-scenes/{name}.lua")
                out = Path(scratch) / "out.png"
                digest = Path(scratch) / "state.txt"
                start = time.monotonic()
                before = resource.getrusage(resource.RUSAGE_CHILDREN)
                run = subprocess.run(["nice", "-n", "10", str(binary), "run", str(src), "--width", str(width), "--out", str(out), "--state-digest", str(digest)], cwd=ROOT, env=env, capture_output=True, text=True, timeout=600)
                after = resource.getrusage(resource.RUSAGE_CHILDREN)
                if run.returncode:
                    raise SystemExit(run.stderr or run.stdout)
                lines = digest.read_text().splitlines()
                row = {"scene": name, "width": width, "wall_seconds": time.monotonic() - start,
                       "user_seconds": after.ru_utime - before.ru_utime, "system_seconds": after.ru_stime - before.ru_stime,
                       "chunk_seconds": sum(float(re.search(r"secs=(\S+)", line)[1]) for line in lines),
                       "digests": [re.sub(r" secs=\S+", "", line) for line in lines]}
                results.append(row)
                print(json.dumps(row), flush=True)
    if a.output:
        a.output.write_text(json.dumps(results, indent=2) + "\n")


if __name__ == "__main__":
    main()
