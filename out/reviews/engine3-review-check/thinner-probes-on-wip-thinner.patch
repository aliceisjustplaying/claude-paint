+/// The reviewer's mixed-field test: does a thin high-solvent stroke elsewhere slow the flow of a thinner-0.5 patch?
+#[test]
+#[ignore = "review probe"]
+fn review_mixed_cap() {
+    println!("[K] patch A: raw sienna thinned .5 (x 150-600, y 200-500). Stroke B: thinned .95, far away (y 800). 2400-px-size pixels. Flow measured in A only (y < 620).");
+    let run = |with_b: bool, max_sub: usize, minutes: usize| {
+        let mut c = Canvas::new(600, 1.0, hex("#d8cdb8")).with_engine(3).with_size_mm(110.0);
+        c.prime(hex("#b9a98c"), 0.9, 60.0, 0.6, 0.0, 7);
+        thinned_patch(&mut c, raw_sienna(), 0.5, (150.0, 600.0), (200.0, 500.0), 51);
+        if with_b {
+            let mut h = brush(Tool::filbert(60.0), 99, raw_sienna().with_thinner(0.95), 0.8);
+            stroke(&mut c, &mut h, vec![(150.0, 800.0), (850.0, 800.0)], 0.8);
+        }
+        let a: Vec<(usize, f32, f32)> = in_rect(&c, (0.0, 0.0, 1000.0, 620.0));
+        let laid: Vec<f32> = a.iter().map(|&(_, x, y)| c.wet_um(x, y)).collect();
+        probe::reset(max_sub);
+        for _ in 0..minutes { c.wait(1.0); }
+        let end: Vec<f32> = a.iter().map(|&(_, x, y)| c.wet_um(x, y)).collect();
+        (laid, end, probe::read())
+    };
+    println!("  minutes | A alone: flow moved (share of A's paint)  capped calls | A with B, cap 64: capped calls  worst need | A's paint, with B vs alone (share of A's flow) | with B: cap 64 vs no cap (share of A's flow)");
+    for minutes in [1usize, 3, 10] {
+        let (laid, alone, st_a) = run(false, 64, minutes);
+        let (laid_b, with_b, st_b) = run(true, 64, minutes);
+        let (_, with_b_free, _) = run(true, 1 << 20, minutes);
+        assert_eq!(laid, laid_b, "A is laid alike with and without B");
+        let moved = l1(&laid, &alone);
+        println!("  {minutes:7} | {:39.3}%  {:12} | {:30}  {:10} | {:44.2}% | {:.2}%", 100.0 * moved / sum(&laid), st_a.1, st_b.1, st_b.2, 100.0 * l1(&with_b, &alone) / moved, 100.0 * l1(&with_b, &with_b_free) / moved);
+    }
+}
