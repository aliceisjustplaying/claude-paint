#!/usr/bin/env python3
import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


def main():
    parser = argparse.ArgumentParser(description="Export a painter studio and print its MCP stdio registration.")
    parser.add_argument("profile")
    parser.add_argument("dest", type=Path)
    parser.add_argument("--brief", type=Path, required=True, help="an approved house BRIEF; only its studio path is changed")
    parser.add_argument("--studio-notes", type=Path, help="approved notes/studio_notes.md to include unchanged")
    parser.add_argument("--ref", default="HEAD", help="committed easel and notes to export")
    parser.add_argument("--sessions-root", type=Path, help="opt in to viewer session recording for a cloud publisher")
    args = parser.parse_args()
    repo = Path(__file__).resolve().parent.parent
    dest = args.dest.expanduser().resolve()
    brief = args.brief.expanduser().read_bytes().decode()
    brief, count = re.subn(r"(?m)^- The folder [^\n]+: this brief, your notes and the easel\.$", lambda _: f"- The folder {dest}: this brief, your notes and the easel.", brief)
    if count != 1:
        parser.error("the approved brief must have exactly one house-template studio-folder line")
    uv = shutil.which("uv")
    if not uv:
        parser.error("install uv before preparing the studio")
    with tempfile.TemporaryDirectory(prefix="capy-studio-") as temp:
        staged = Path(temp) / "studio"
        env = dict(os.environ, R16_BRANCH=args.ref, TMPDIR=temp)
        subprocess.run([str(repo / "scripts/export_r16_studio"), args.profile, str(staged)], env=env, stdout=sys.stderr, check=True)
        if args.studio_notes:
            shutil.copy2(args.studio_notes.expanduser(), staged / "notes/studio_notes.md")
        missing = [path for path in re.findall(r"notes/[\w./-]+\.md", brief) if not (staged / path).is_file()]
        if missing:
            parser.error("the approved brief names missing notes: " + ", ".join(sorted(set(missing))))
        (staged / "BRIEF.md").write_bytes(brief.encode())
        runtime = staged / "bin/mcp"
        runtime.mkdir(exist_ok=True)
        for name in ("server.py", "references.py", "tools.json", *(["remote.py"] if args.sessions_root else [])):
            shutil.copy2(repo / "harness/easel_mcp" / name, runtime / name)
        if dest.exists():
            dest.rmdir()
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(staged), dest)
    runtime = dest / "bin/mcp"
    registration = {
        "command": uv,
        "args": ["run", "--no-project", "--script", str(runtime / "server.py"), "--studio", str(dest)],
        "cwd": str(dest),
        "env": {},
    }
    if args.sessions_root:
        registration["args"] += ["--sessions-root", str(args.sessions_root.expanduser().resolve())]
    print(json.dumps(registration, indent=2))


if __name__ == "__main__":
    main()
