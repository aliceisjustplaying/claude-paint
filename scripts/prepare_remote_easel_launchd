#!/usr/bin/env python3
import argparse
from pathlib import Path
import plistlib
import shutil


def main():
    parser = argparse.ArgumentParser(description="Prepare inactive launchd plists; does not start HTTP or a tunnel.")
    parser.add_argument("--studio", type=Path, required=True)
    parser.add_argument("--token-file", type=Path, required=True)
    parser.add_argument("--out", type=Path, required=True)
    parser.add_argument("--port", type=int, default=8790)
    parser.add_argument("--uv", default=shutil.which("uv"))
    parser.add_argument("--cloudflared", default=shutil.which("cloudflared"))
    args = parser.parse_args()
    if not args.uv or not args.cloudflared:
        parser.error("install uv and cloudflared or supply their absolute paths")
    out = args.out.expanduser().resolve()
    active = Path.home() / "Library/LaunchAgents"
    if out.is_relative_to(active.resolve()):
        parser.error("stage these files outside Library/LaunchAgents until the tunnel is approved")
    if not 1024 <= args.port <= 65535:
        parser.error("port must be between 1024 and 65535")
    out.mkdir(parents=True, exist_ok=True)
    repo = Path(__file__).resolve().parent.parent
    logs = out / "logs"
    logs.mkdir(exist_ok=True)
    http = {
        "Label": "art.stillwet.easel-mcp.http",
        "ProgramArguments": [args.uv, "run", "--no-project", "--script", str(repo / "harness/easel_mcp/http_server.py"), "--studio", str(args.studio.expanduser().resolve()), "--token-file", str(args.token_file.expanduser().resolve()), "--port", str(args.port)],
        "WorkingDirectory": str(repo), "RunAtLoad": True, "KeepAlive": True, "ThrottleInterval": 15,
        "StandardOutPath": str(logs / "http.log"), "StandardErrorPath": str(logs / "http.log"),
    }
    tunnel = {
        "Label": "art.stillwet.easel-mcp.tunnel",
        "ProgramArguments": [args.cloudflared, "tunnel", "--no-autoupdate", "--url", f"http://127.0.0.1:{args.port}", "--http-host-header", f"localhost:{args.port}", "--logfile", str(logs / "tunnel.log")],
        "RunAtLoad": True, "KeepAlive": True, "ThrottleInterval": 15,
        "StandardOutPath": str(logs / "tunnel-output.log"), "StandardErrorPath": str(logs / "tunnel-output.log"),
    }
    for definition in (http, tunnel):
        path = out / (definition["Label"] + ".plist")
        with path.open("xb") as file:
            plistlib.dump(definition, file)
        print(path)


if __name__ == "__main__":
    main()
