#!/usr/bin/env python3
"""Test one exact commit in a fresh, clean, temporary working copy and record a receipt.

    scripts/test_candidate COMMIT [--base-main COMMIT] [--remote origin]
                           [--timeout 600] [--lock-timeout SECONDS] [--list-file PATH]

- COMMIT must be a commit id (hex). Branch names, tags, unknown ids, ambiguous
  prefixes and ids that are also ref names are refused: a name can move
  between test and merge.
- The reviewed check set is read from the commit itself before anything
  runs: the list file (--list-file, default notes/speed/test_lists/all.tsv)
  is parsed from `git show COMMIT:LIST`, and scripts/test is hashed as
  committed. Refused (exit 2) if either is missing or not a regular file, the
  list is malformed, a non-build step requires fewer than 1 test, or no step
  is a non-build step.
- The commit is checked out with `git worktree add --detach` into a new
  directory under /tmp, made a FULL checkout (the repository's post-checkout
  hook makes new worktrees sparse; this undoes it) and verified: HEAD and tree
  are the commit's, the index is exactly the commit's tree (`git ls-files -s`
  equals `git ls-tree -r`), not sparse, no skip-worktree/assume-unchanged
  flags, and `git status` shows nothing (untracked or ignored files
  included). Otherwise it refuses (exit 2).
- Inside it, one outer `lockrun --timeout SECONDS` runs
  `scripts/test --all --summary FILE` (plus `--list LIST` for a non-default
  list) with CARGO_TARGET_DIR inside the temporary working copy.
- lockrun is never the candidate's own: only a file whose sha256 is the pin
  LOCKRUN_SHA256 in safeguards_lib.py is used. If $LOCKRUN is set, it must be
  such a file, or the run is refused (exit 2): an explicit choice is never
  replaced silently. Otherwise the first pinned one of
  ~/src/a/claude-paint-tools/lockrun and the scripts/lockrun beside this
  tool (its own checkout, not the candidate) is used; one that is missing or
  differs is skipped with a message. None: refused (exit 2), nothing run.
  The chosen bytes are hashed once and copied to the temporary directory,
  outside the working copy, and that copy is what runs. The receipt records
  its path, source and sha256.
- After the run the same checkout checks are repeated (HEAD, tree, index,
  sparse, flags, tracked changes): any difference fails the run. The
  evidence from before and after goes into the receipt.
- Pass needs all of: exit 0; a summary with mode "all", verdict "pass", whose
  list is LIST, list_sha256 the list's hash in the commit, runner_sha256 the
  hash of scripts/test in the commit, and whose steps are exactly the list's
  steps (same order; same name, kind, command, limit, least and group; none
  omitted, added or repeated), every step exit 0, ok, timed_out false,
  failed 0 and, unless its kind is "build", tests_run >= its least >= 1 and
  passed >= 1; every step's log present with the sha256 the summary claims;
  the checkout unchanged after the run; and the cleanup succeeded. A timeout
  (lockrun's or a step's: summary verdict "unfinished"), cancellation or busy
  lock is "unfinished". Anything else is "fail".
- The temporary working copy and its build directory are always removed
  (worktree remove --force, rm -rf, worktree prune) in a finally of its own,
  also on failure, timeout, Ctrl-C, SIGTERM, SIGHUP and errors while reading
  the results. A failed removal makes the verdict "fail".
- Receipt: JSON in a git note on the commit, ref refs/notes/test-receipts
  (`git notes --ref=test-receipts add -f`: the latest run replaces the
  previous note; every run's receipt also stays in the receipt directory).
  Logs, summary and receipt.json go to $TEST_RECEIPT_DIR (default
  ~/src/a/claude-paint-receipts)/<commit>/<time>/. Notes are not pushed or
  fetched with branches:
      git fetch origin refs/notes/test-receipts:refs/notes/test-receipts
      git push origin refs/notes/test-receipts

Exit: 0 pass, 1 fail, 3 unfinished (timeout, cancelled, lock busy), 2 refused
before testing (no receipt written).
"""

import argparse
import json
import os
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import tomllib

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from safeguards_lib import (DEFAULT_LIST, LOCKRUN_SHA256, RECEIPT_FORMAT, RECEIPTS_REF,  # noqa: E402
                            TOOLS_LOCKRUN, Refuse, assert_publishable, checkout_problems,
                            checkout_state, git, home_redact, is_ancestor, manifest_at,
                            manifest_problems, now_iso, resolve_exact_commit, run, sha256_bytes,
                            sha256_file, summary_problems, toplevel, tools_sha256, tree_of)

HERE = os.path.dirname(os.path.abspath(__file__))
TOOL_FILES = [os.path.abspath(__file__), os.path.join(HERE, "safeguards_lib.py")]
EXIT_PASS, EXIT_FAIL, EXIT_REFUSED, EXIT_UNFINISHED = 0, 1, 2, 3


def say(msg):
    sys.stderr.write("test_candidate: %s\n" % msg)
    sys.stderr.flush()


class Stop(Exception):
    pass


def on_signal(signum, frame):
    raise Stop(signum)


def resolve_base(repo, args):
    if args.base_main:
        return resolve_exact_commit(repo, args.base_main, "--base-main"), "argument --base-main"
    for ref, source in (("refs/heads/main", "local branch main (refs/heads/main)"),
                        ("refs/remotes/%s/main" % args.remote,
                         "remote-tracking branch refs/remotes/%s/main (as last fetched)" % args.remote)):
        p = run(["git", "-C", repo, "rev-parse", "--verify", "-q", ref + "^{commit}"], check=False)
        if p.returncode == 0:
            return p.stdout.strip(), source
    raise Refuse("no main found (refs/heads/main or refs/remotes/%s/main); pass --base-main" % args.remote)




def _read(path):
    try:
        with open(path, "rb") as f:
            return f.read()
    except OSError:
        return None


def pick_lockrun():
    """(path, source, bytes) of the approved lockrun (sha256 == LOCKRUN_SHA256); Refuse if none.
    Never the candidate's: the candidate's working copy does not exist yet."""
    env = os.environ.get("LOCKRUN")
    if env:
        path = os.path.abspath(env)
        data = _read(path)
        got = "unreadable" if data is None else "sha256 " + sha256_bytes(data)
        if data is None or sha256_bytes(data) != LOCKRUN_SHA256:
            raise Refuse("$LOCKRUN=%s is not the approved lockrun (%s, pinned %s in safeguards_lib.py)"
                         % (home_redact(path), got, LOCKRUN_SHA256))
        return path, "$LOCKRUN", data
    skipped = []
    for path, source in ((os.path.expanduser(TOOLS_LOCKRUN), TOOLS_LOCKRUN),
                         (os.path.join(HERE, "lockrun"), "scripts/lockrun beside test_candidate")):
        data = _read(path)
        if data is not None and sha256_bytes(data) == LOCKRUN_SHA256:
            return path, source, data
        why = "%s (%s): %s" % (source, home_redact(path), "missing or unreadable" if data is None
                                else "sha256 %s is not the pin" % sha256_bytes(data))
        say("skipping lockrun %s" % why)
        skipped.append(why)
    raise Refuse("no approved lockrun (sha256 %s): %s" % (LOCKRUN_SHA256, "; ".join(skipped)))


def _toml(path):
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return None


def _version(cmd, cwd):
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=60)
        return p.stdout.strip() if p.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def build_settings(wt, summary):
    s = {"rustc": _version(["rustc", "-V"], wt), "cargo": _version(["cargo", "-V"], wt),
         "cargo_target_dir": "<temporary working copy>/target", "configs": []}
    cargo_home = os.environ.get("CARGO_HOME") or os.path.expanduser("~/.cargo")
    cflags = wrapper = wrapper_src = None
    profiles = set()
    for label, path in (("<candidate>/.cargo/config.toml", os.path.join(wt, ".cargo", "config.toml")),
                        ("<candidate>/.cargo/config", os.path.join(wt, ".cargo", "config")),
                        (os.path.join(cargo_home, "config.toml"), os.path.join(cargo_home, "config.toml")),
                        (os.path.join(cargo_home, "config"), os.path.join(cargo_home, "config"))):
        if not os.path.isfile(path):
            continue
        data = _toml(path) or {}
        s["configs"].append({"path": label, "sha256": sha256_file(path)})
        env = data.get("env", {})
        if cflags is None and "CFLAGS" in env:
            v = env["CFLAGS"]
            cflags = v.get("value") if isinstance(v, dict) else v
        w = data.get("build", {}).get("rustc-wrapper")
        if wrapper is None and w is not None:
            wrapper, wrapper_src = w, label
        profiles.update(data.get("profile", {}).keys())
    cargo_toml = _toml(os.path.join(wt, "Cargo.toml")) or {}
    profiles.update(cargo_toml.get("profile", {}).keys())
    for var in ("RUSTC_WRAPPER", "CARGO_BUILD_RUSTC_WRAPPER"):
        if os.environ.get(var) is not None:
            wrapper, wrapper_src = os.environ[var], "$" + var
    s["cflags"] = cflags
    s["cflags_env_override"] = os.environ.get("CFLAGS")
    s["rustflags_env"] = os.environ.get("RUSTFLAGS")
    s["rustc_wrapper"] = wrapper
    s["rustc_wrapper_source"] = wrapper_src
    s["profiles_declared"] = sorted(profiles)
    used = set()
    for step in (summary or {}).get("steps") or []:
        cmd = step.get("command") if isinstance(step, dict) else None
        toks = shlex.split(cmd) if isinstance(cmd, str) else [str(t) for t in (cmd or [])]
        if "cargo" not in " ".join(toks):
            continue
        prof = None
        for i, t in enumerate(toks):
            if t == "--release":
                prof = "release"
            elif t == "--profile" and i + 1 < len(toks):
                prof = toks[i + 1]
            elif t.startswith("--profile="):
                prof = t.split("=", 1)[1]
        used.add(prof or "default (dev/test)")
    s["profiles_used"] = sorted(used)
    return s




def verify_full_clean_checkout(wt, sha, tree):
    """Refuse unless the worktree is exactly COMMIT, complete and clean. Returns its state."""
    state = checkout_state(wt, sha)
    bad = checkout_problems(state, sha, tree, "after checkout")
    if bad:
        raise Refuse("the temporary working copy is not a full checkout of the commit: " + "; ".join(bad))
    status = git(wt, "status", "--porcelain=v1", "--untracked-files=all", "--ignored")
    if status:
        raise Refuse("the temporary working copy is not clean after checkout:\n" + status)
    return state


def collect(wt, summary_path, receipt_dir, manifest):
    """Parse the summary, copy logs out, check it against the manifest.
    Returns (summary, logs, problems)."""
    problems = []
    summary = None
    if not os.path.isfile(summary_path):
        problems.append("scripts/test wrote no summary")
    else:
        raw = open(summary_path, "rb").read()
        shutil.copyfile(summary_path, os.path.join(receipt_dir, "summary.json"))
        try:
            summary = json.loads(raw)
        except ValueError:
            problems.append("the summary is not valid JSON")
    problems += summary_problems(summary, manifest)
    logs = []
    steps = summary.get("steps") if isinstance(summary, dict) else None
    os.makedirs(os.path.join(receipt_dir, "logs"), exist_ok=True)
    for i, step in enumerate(steps if isinstance(steps, list) else []):
        if not isinstance(step, dict):
            continue
        name = str(step.get("name") or "step%d" % i)
        log = step.get("log")
        if not log or not isinstance(log, str):
            problems.append("step %s names no log" % name)
            continue
        src = log if os.path.isabs(log) else os.path.join(wt, log)
        if not os.path.isfile(src):
            problems.append("step %s: log %s is missing" % (name, log))
            continue
        safe = "".join(c if c.isalnum() or c in "-_." else "_" for c in name)[:60]
        dst_name = "logs/%02d-%s.log" % (i, safe)
        shutil.copyfile(src, os.path.join(receipt_dir, dst_name))
        h = sha256_file(os.path.join(receipt_dir, dst_name))
        if step.get("log_sha256") != h:
            problems.append("step %s: log sha256 %s differs from the summary's %r"
                            % (name, h, step.get("log_sha256")))
        logs.append({"step": name, "file": dst_name, "sha256": h,
                     "summary_log_sha256": step.get("log_sha256")})
    return summary, logs, problems


def remove_worktree(repo, wt, tmp):
    """Remove the temporary working copy and its directory. Returns the errors ([] = removed)."""
    errors = []
    try:
        if os.path.exists(wt):
            p = run(["git", "-C", repo, "worktree", "remove", "--force", "--force", wt], check=False)
            if p.returncode != 0:
                errors.append("git worktree remove: " + p.stderr.strip())
        shutil.rmtree(tmp, ignore_errors=True)
        run(["git", "-C", repo, "worktree", "prune"], check=False)
        if os.path.exists(tmp):
            errors.append("%s still exists" % tmp)
        listed = git(repo, "worktree", "list", "--porcelain")
        if any(l == "worktree " + wt or l == "worktree " + os.path.realpath(wt) for l in listed.splitlines()):
            errors.append("git still lists the worktree")
    except Exception as e:  # noqa: BLE001 - any failure here is a cleanup failure, reported
        errors.append("cleanup raised %s: %s" % (type(e).__name__, e))
    return errors


def add_note(repo, sha, text):
    """Write TEXT as SHA's receipt note and read it back. Writers are serialized by an
    exclusive lock in the repository's common git directory: concurrent `git notes add`
    runs can otherwise each rewrite refs/notes/test-receipts from the same parent and
    silently drop one another's receipts."""
    import fcntl
    common = git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir")
    with open(os.path.join(common, "test-receipts.lock"), "a") as lock:
        deadline = time.monotonic() + 60
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    raise Refuse("another receipt writer held the notes lock for 60 s")
                time.sleep(0.05)
        p = run(["git", "-C", repo, "notes", "--ref=test-receipts", "add", "-f", "-m", text, sha], check=False)
        if p.returncode != 0:
            raise Refuse("git notes add failed: %s" % p.stderr.strip())
        back = run(["git", "-C", repo, "notes", "--ref=test-receipts", "show", sha], check=False)
        if back.returncode != 0 or back.stdout.strip() != text.strip():
            raise Refuse("the receipt note did not read back as written")


def main():
    ap = argparse.ArgumentParser(prog="test_candidate", description=__doc__.split("\n\n")[0])
    ap.add_argument("commit")
    ap.add_argument("--base-main", help="main commit the candidate is based on (default: refs/heads/main, "
                    "else refs/remotes/REMOTE/main)")
    ap.add_argument("--remote", default="origin")
    ap.add_argument("--timeout", type=float, default=600.0, help="lockrun --timeout (seconds)")
    ap.add_argument("--lock-timeout", type=float, help="give up if the lock is not free in time")
    ap.add_argument("--list-file", default=DEFAULT_LIST,
                    help="the test list in the commit (default %s)" % DEFAULT_LIST)
    args = ap.parse_args()

    t_start, started_at = time.monotonic(), now_iso()
    try:
        repo = toplevel(".")
        sha = resolve_exact_commit(repo, args.commit)
        tree = tree_of(repo, sha)
        base, base_source = resolve_base(repo, args)
        manifest = manifest_at(repo, sha, args.list_file)
        bad = manifest_problems(manifest["steps"])
        if bad:
            raise Refuse("the test list %s at %s can't pass: %s" % (args.list_file, sha[:12], "; ".join(bad)))
        lockrun_path, lockrun_src, lockrun_bytes = pick_lockrun()
    except Refuse as e:
        say("REFUSED: %s" % e)
        return EXIT_REFUSED
    say("candidate %s (tree %s); base main %s from %s" % (sha, tree, base, base_source))
    say("check set: %s (%d steps, sha256 %s), %s sha256 %s" % (
        manifest["list"], len(manifest["steps"]), manifest["list_sha256"][:12],
        manifest["runner"], manifest["runner_sha256"][:12]))

    receipt_root = os.environ.get("TEST_RECEIPT_DIR") or os.path.expanduser("~/src/a/claude-paint-receipts")
    receipt_dir = os.path.join(receipt_root, sha, time.strftime("%Y%m%dT%H%M%S") + "-%d" % os.getpid())
    # under /tmp, not a deep $TMPDIR: the easel's tests bind Unix sockets under the build
    # dir's tmp/, and macOS refuses socket paths of 104 bytes or more. Resolved (/tmp is
    # /private/tmp there): the easel prints resolved paths, and its tests compare them with
    # CARGO_TARGET_TMPDIR, which cargo derives from the target dir as given
    tmp = os.path.realpath(tempfile.mkdtemp(prefix="cpc.", dir="/tmp"))
    wt = os.path.join(tmp, "wt")
    summary_path = os.path.join(tmp, "summary.json")
    say("temporary working copy: %s" % wt)
    lockrun = os.path.join(tmp, "lockrun")

    for s in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, on_signal)
    proc = None
    tested = False
    refused = None
    cancelled = None
    code = None
    problems, summary, logs, settings = [], None, [], {}
    checkout = {}
    lockrun_info = {}
    cleanup_errors = ["cleanup did not run"]
    try:
        try:
            try:
                # the approved lockrun's checked bytes, outside the working copy: what runs is
                # exactly what was hashed, and the candidate can't replace it
                with open(lockrun, "wb") as f:
                    f.write(lockrun_bytes)
                os.chmod(lockrun, 0o500)
                say("lockrun: %s from %s (sha256 %s), run as a copy at %s"
                    % (home_redact(lockrun_path), lockrun_src, LOCKRUN_SHA256[:12], lockrun))
                p = run(["git", "-C", repo, "worktree", "add", "--detach", wt, sha], check=False)
                sys.stderr.write(p.stderr)
                if p.returncode != 0:
                    raise Refuse("git worktree add failed")
                run(["git", "-C", wt, "sparse-checkout", "disable"], check=False)
                checkout["before"] = verify_full_clean_checkout(wt, sha, tree)
                checkout["clean_before"] = True
            except Refuse as e:
                refused = str(e)
            if refused is None:
                os.makedirs(receipt_dir, exist_ok=True)
                lockrun_log = os.path.join(receipt_dir, "lockrun.log")
                cmd = [lockrun, "--timeout", "%g" % args.timeout, "--log", lockrun_log, "--owner",
                       "test_candidate %s" % sha[:12]]
                if args.lock_timeout is not None:
                    cmd += ["--lock-timeout", "%g" % args.lock_timeout]
                cmd += ["--", "scripts/test", "--all", "--summary", summary_path]
                if args.list_file != DEFAULT_LIST:
                    cmd += ["--list", args.list_file]
                env = dict(os.environ, CARGO_TARGET_DIR=os.path.join(wt, "target"))
                lockrun_info = {"path": home_redact(lockrun_path), "source": lockrun_src,
                                "sha256": sha256_file(lockrun), "pinned_sha256": LOCKRUN_SHA256,
                                "ran": "a copy in the temporary directory, outside the working copy",
                                "command": home_redact(shlex.join(["lockrun"] + cmd[1:]))}
                if not os.access(os.path.join(wt, "scripts", "test"), os.X_OK):
                    problems.append("the commit has no executable scripts/test")
                else:
                    tested = True
                    say("running: %s" % shlex.join(cmd))
                    proc = subprocess.Popen(cmd, cwd=wt, env=env, stdin=subprocess.DEVNULL)
                    code = proc.wait()
        except (KeyboardInterrupt, Stop) as e:
            cancelled = "SIGINT" if isinstance(e, KeyboardInterrupt) else signal.Signals(e.args[0]).name
            say("cancelled (%s); stopping the test and cleaning up" % cancelled)
        finally:
            for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
                signal.signal(s, signal.SIG_IGN)
            if proc is not None and proc.poll() is None:
                try:
                    proc.send_signal(signal.SIGTERM)  # lockrun stops the job's process group
                    code = proc.wait(timeout=60)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    code = proc.wait()
            if tested:
                try:
                    checkout["after"] = checkout_state(wt, sha)
                except Exception as e:  # noqa: BLE001 - no evidence is itself the failure
                    checkout["after"] = None
                    checkout["after_error"] = "%s: %s" % (type(e).__name__, e)
                problems += checkout_problems(checkout["after"], sha, tree, "after the test")
                try:
                    summary, logs, more = collect(wt, summary_path, receipt_dir, manifest)
                    problems += more
                except Exception as e:  # noqa: BLE001
                    problems.append("reading the results failed: %s: %s" % (type(e).__name__, e))
                try:
                    settings = build_settings(wt, summary)
                except Exception as e:  # noqa: BLE001
                    problems.append("reading the build settings failed: %s: %s" % (type(e).__name__, e))
    finally:
        for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(s, signal.SIG_IGN)
        cleanup_errors = remove_worktree(repo, wt, tmp)
        for err in cleanup_errors:
            say("CLEANUP FAILED: %s" % err)
        if not cleanup_errors:
            say("removed the temporary working copy and its build directory")
        if os.path.isdir(receipt_dir) and not os.listdir(receipt_dir):
            os.rmdir(receipt_dir)

    if refused is not None and not cancelled:
        say("REFUSED: %s" % refused)
        if cleanup_errors:
            say("and the temporary working copy could not be removed (see above)")
        return EXIT_REFUSED
    if not tested and not problems:
        return EXIT_UNFINISHED if cancelled else EXIT_REFUSED
    if code is not None and code != 0:
        problems.insert(0, "scripts/test (under lockrun) exited %d" % code)
    inner_timeout = isinstance(summary, dict) and summary.get("verdict") == "unfinished"
    unfinished = cancelled or code in (124, 130, 75) or inner_timeout
    if inner_timeout:
        timed = [s.get("name") for s in summary.get("steps") or [] if isinstance(s, dict) and s.get("timed_out")]
        problems.insert(0, "scripts/test reported unfinished work (timed out: %s)" % (", ".join(map(str, timed)) or "?"))
    if cancelled:
        problems.insert(0, "cancelled (%s)" % cancelled)
    if code == 124:
        problems.insert(0, "timed out after %g s (lockrun exit 124)" % args.timeout)
    if code == 75:
        problems.insert(0, "the lock was not free within --lock-timeout; nothing ran")
    problems += ["cleanup failed: %s" % e for e in cleanup_errors]
    verdict = "unfinished" if unfinished else ("fail" if problems or code != 0 else "pass")

    os.makedirs(receipt_dir, exist_ok=True)
    receipt = {
        "format": RECEIPT_FORMAT,
        "verdict": verdict,
        "problems": problems,
        "candidate": {"commit": sha, "tree": tree, "requested": args.commit},
        "base_main": {"commit": base, "source": base_source, "is_ancestor": is_ancestor(repo, base, sha)},
        "exit": code,
        "timeout_s": args.timeout,
        "started_at": started_at,
        "ended_at": now_iso(),
        "seconds": round(time.monotonic() - t_start, 3),
        "tool": {"name": "scripts/test_candidate", "sha256": tools_sha256(*TOOL_FILES)},
        "lockrun": lockrun_info,
        "checkout": checkout,
        "cleanup_errors": cleanup_errors,
        "build": settings,
        "manifest": manifest,
        "summary": summary,
        "summary_sha256": sha256_file(os.path.join(receipt_dir, "summary.json"))
        if os.path.isfile(os.path.join(receipt_dir, "summary.json")) else None,
        "logs": logs,
        "lockrun_log_sha256": sha256_file(os.path.join(receipt_dir, "lockrun.log"))
        if os.path.isfile(os.path.join(receipt_dir, "lockrun.log")) else None,
        "receipt_dir": home_redact(receipt_dir),
    }
    text = home_redact(json.dumps(receipt, indent=1, sort_keys=True)) + "\n"
    with open(os.path.join(receipt_dir, "receipt.json"), "w") as f:
        f.write(text)
    try:
        assert_publishable(text, "the receipt")
        add_note(repo, sha, text)
        say("receipt recorded: git notes --ref=test-receipts show %s" % sha[:12])
    except Refuse as e:
        say("RECEIPT NOT RECORDED: %s (local copy: %s)" % (e, home_redact(receipt_dir)))
        verdict = "fail" if verdict == "pass" else verdict
    say("receipt files: %s" % home_redact(receipt_dir))
    for prob in problems:
        say("  - %s" % prob)
    say("VERDICT: %s for %s" % (verdict.upper(), sha))
    say("notes are not pushed with branches: git push %s %s" % (args.remote, RECEIPTS_REF))
    return {"pass": EXIT_PASS, "fail": EXIT_FAIL}.get(verdict, EXIT_UNFINISHED)


if __name__ == "__main__":
    sys.exit(main())
