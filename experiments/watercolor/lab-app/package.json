{
  "name": "watercolor-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A physically-based watercolor simulator: shallow-water fluid dynamics after Curtis et al. (SIGGRAPH 1997) and Kubelka-Munk pigment optics, in the browser",
  "keywords": [
    "watercolor",
    "simulation",
    "kubelka-munk",
    "fluid-dynamics",
    "webgl2",
    "painting"
  ],
  "license": "MIT",
  "author": "Ryan McCarty (https://ryankm.com)",
  "homepage": "https://watercolor.ryankm.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxpreview/watercolor-lab.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.24.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
