#!/usr/bin/env python3
import argparse
import json
import math
import os
from pathlib import Path
import re
import shutil
import tempfile


CRITIC_READING = (
    "\n\n"
    "Another painter visits your studio as a critic, at the end of each sitting\n"
    "and whenever you ask for a visit with `ask_critic`. The critic looks at the\n"
    "painting with the same `look` you use and reads your journal and the note\n"
    "you give `ask_critic` (kept in notes/to_critic.md); it doesn't paint. It\n"
    "writes whether it thinks the picture is finished and, if not, what matters\n"
    "most to the picture and why, in notes/critic.md, which you get at the start\n"
    "of your next sitting or as `ask_critic`'s reply. It doesn't see your code,\n"
    "masks or mixtures: weigh what it sees against the picture, and treat a\n"
    "method it suggests as one way to try, at the passage's real scale."
)


def prepare(studio, sessions_root, break_seconds=0, sitting_seconds=None):
    studio = studio.expanduser().resolve(strict=True)
    if not re.fullmatch(r"paint-studio-[0-9a-f]+", studio.name):
        raise ValueError("the studio folder must be named paint-studio-<hex> for the viewer")
    if not (studio / "BRIEF.md").is_file():
        raise ValueError("the prepared studio is missing BRIEF.md")
    if not ((studio / "bin/easel").is_file() or (studio / "bin/watercolor-studio").is_file()):
        raise ValueError("the prepared studio is missing bin/easel or bin/watercolor-studio")
    if any(value is not None and (not math.isfinite(value) or value < 0) for value in (break_seconds, sitting_seconds)):
        raise ValueError("durations must be finite and nonnegative")
    uv = shutil.which("uv")
    if not uv:
        raise ValueError("uv is not installed")
    repo = Path(__file__).resolve().parent.parent
    runtime = studio / "bin/mcp"
    agents = studio / ".agents/agents"
    if (studio / ".agents/mcp_config.json").exists() or (agents / "easel-painter.md").exists():
        raise ValueError("the studio already has agy configuration")
    outputs = {}
    for name in ("server.py", "remote.py", "references.py", "tools.json", "sittings.py", "sitting-tools.json", "sitting-message.txt", "painting_chunks.py", "critic.py", "critic-tools.json"):
        source = repo / "harness/easel_mcp" / name
        outputs[runtime / name] = (source.read_bytes(), source.stat().st_mode & 0o777)
    for source, target in ((repo / "harness/agy/painter.md", agents / "easel-painter.md"),
                           (repo / "harness/agy/LAUNCH.md", studio / "LAUNCH.md")):
        outputs[target] = (source.read_bytes(), source.stat().st_mode & 0o777)
    sessions_root = sessions_root.expanduser().resolve()
    args = ["run", "--no-project", "--script", str(runtime / "server.py"), "--studio", str(studio),
            "--sittings", "--agy", "--break-seconds", str(break_seconds), "--sessions-root", str(sessions_root)]
    if sitting_seconds is not None:
        args += ["--sitting-seconds", str(sitting_seconds)]
    env = {"PAINTER_CRITIC_CLI": str(repo / "harness/painter/visit-cli.ts")}
    if "PAINTER_CRITIC" in os.environ:
        env["PAINTER_CRITIC"] = os.environ["PAINTER_CRITIC"]
    if env.get("PAINTER_CRITIC") and (studio / "bin/easel").is_file() and not (studio / "bin/watercolor-studio").is_file():
        for name in ("easel_guide.md", "watercolor_easel_guide.md"):
            guide = studio / "notes" / name
            if guide.is_file():
                text = guide.read_text()
                if CRITIC_READING.lstrip("\n") not in text:
                    outputs[guide] = ((text + CRITIC_READING).encode(), guide.stat().st_mode & 0o777)
    config = {"mcpServers": {"easel": {"command": uv, "args": args, "cwd": str(studio), "env": env}}}
    outputs[studio / ".agents/mcp_config.json"] = ((json.dumps(config, indent=2) + "\n").encode(), 0o644)
    folder = "--" + str(studio).strip("/").replace("/", "-") + "--"
    if "-src-a-" not in folder:
        folder = f"--mcp-src-a-{studio.name}--"
    viewer = sessions_root / folder / "agy.jsonl"
    metadata = {"recorder": str(studio / "out/easel/mcp/session.jsonl"), "output": str(viewer)}
    outputs[studio / ".agents/recording.json"] = ((json.dumps(metadata, indent=2) + "\n").encode(), 0o644)
    originals = {path: (path.read_bytes(), path.stat().st_mode & 0o777) if path.exists() else None for path in outputs}
    with tempfile.TemporaryDirectory(prefix=".agy-prepare-", dir=studio) as temporary:
        stage = Path(temporary)
        for index, (path, (data, mode)) in enumerate(outputs.items()):
            (stage / str(index)).write_bytes(data)
            (stage / str(index)).chmod(mode)
            if originals[path] is not None:
                data, mode = originals[path]
                (stage / f"before-{index}").write_bytes(data)
                (stage / f"before-{index}").chmod(mode)
        published = []
        try:
            for index, path in enumerate(outputs):
                path.parent.mkdir(parents=True, exist_ok=True)
                if originals[path] is None:
                    os.link(stage / str(index), path)
                else:
                    os.replace(stage / str(index), path)
                published.append((index, path, path.stat()))
        except BaseException:
            for index, path, owned in reversed(published):
                try:
                    current = path.lstat()
                except FileNotFoundError:
                    continue
                if (current.st_dev, current.st_ino) != (owned.st_dev, owned.st_ino):
                    continue
                if originals[path] is None:
                    path.unlink()
                else:
                    os.replace(stage / f"before-{index}", path)
            raise
    return config


def main():
    parser = argparse.ArgumentParser(description="Configure an existing approved studio for human-started agy.")
    parser.add_argument("studio", type=Path)
    parser.add_argument("--sessions-root", required=True, type=Path)
    parser.add_argument("--break-seconds", type=float, default=0)
    parser.add_argument("--sitting-seconds", type=float)
    args = parser.parse_args()
    try:
        config = prepare(args.studio, args.sessions_root, args.break_seconds, args.sitting_seconds)
    except (ValueError, OSError) as error:
        parser.error(str(error))
    print(json.dumps(config, indent=2))


if __name__ == "__main__":
    main()
